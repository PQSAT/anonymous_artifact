          case UE_8
          solve( !KU( mac(kdf(~ssgu),
                          h(<
                             <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                              h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                              ~muS, ~T2>, 
                             $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                             h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>))
                 ) @ #vk.66 )
            case GS_3
