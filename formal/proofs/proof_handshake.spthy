                                    h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>),
                                 ~ltkS.2)
                       ) @ #vk.66 )
                  case GS_3
                  solve( !KU( h(<
                                 kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                      $G, 
                                      <
                                       <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                        ~muS, ~T2>, 
                                       $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                       h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                      'SK'>), 
                                 ~muU, ~muS, ~muG, 'SAT-fin'>)
                         ) @ #vk.28 )
                    case SAT_7
                    solve( (#i2 < #i)  ∥ (#i < #i2) )
                      case case_1
                      solve( Commit( 'GS', 'SAT', U2, S2, G2,
                                     kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                          $G, 
                                          <
                                           <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                            $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                            h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                           $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                           h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                          'SK'>)
                             ) @ #i2 )
                        case GS_8
                        solve( GS_St7( $G.1, $U.1, $S.1,
                                       kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                            $G, 
                                            <
                                             <
                                              <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1
                                              >, 
                                              $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                              h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                             $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                             h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                            'SK'>),
                                       muU.1, muS.1, muG.1
                               ) ▶₁ #i2 )
                          case GS_7
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case case_2
