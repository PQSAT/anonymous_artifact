                                            h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                           'SK'>),
                                      muU.1, muS.1, muG.1
                             ) ▶₁ #i2 )
                        case SAT_7
                        by contradiction /* cyclic */
                      qed
                    qed
                  next
                    case case_2
                    solve( Commit( 'SAT', 'UE', U2, S2, G2,
                                   kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                        $G, 
                                        <
                                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                          $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                          h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                         $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                         h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                        'SK'>)
                           ) @ #i2 )
                      case SAT_8
                      solve( SAT_St7( $S.1, $U.1, $G.1,
                                      kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                           $G, 
                                           <
                                            <
                                             <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1
                                             >, 
                                             $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                             h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
