            case SAT_2
            solve( !KU( senc(<'wrap-gu-s', kgu, ~ssgu>,
                             kdf(<~kgs, ~sssg, 'wrap-sg'>))
                   ) @ #vk.10 )
              case GS_7
              solve( !KU( h(<
