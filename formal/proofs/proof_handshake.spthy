                    by contradiction /* from formulas */
                  qed
                qed
              qed
            next
              case c_sign
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma agree_dsa_sat_gs [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'SAT', 'GS', U, S, G, sk ) @ #i) ⇒
    (((((((∃ #j.
            ((Running( 'GS', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
            (¬(∃ U2 S2 G2 #i2.
                (Commit( 'SAT', 'GS', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
          (∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i))) ∨
         (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
        (∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ e #r. RevKgs( e ) @ #r)) ∨
     (∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'SAT', 'GS', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'GS', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'SAT', 'GS', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'SAT', 'GS', U, S, G, sk ) @ #i )
  case SAT_7
  solve( SAT_St6( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG, Pi3,
                  mac(kdf(ssgu), h(Pi3))
         ) ▶₁ #i )
    case SAT_6
    solve( !KU( mac(kdf(ssgu),
                    h(<
                       <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                       >, 
                       $G, h(cgu), h(aenc(kgs, pk(~eskS))), h(egu), muG, T3>))
           ) @ #vk.16 )
      case GS_3
      solve( !KU( mac(kdf(ssus),
                      h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.34 )
        case UE_1
        solve( !KU( mac(kdf(~sssg),
                        h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                           h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                           ~muS, ~T2>))
               ) @ #vk.51 )
          case SAT_2
          solve( !KU( sign(h(<
                              <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                               h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                               ~muS, ~T2>, 
                              $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                              h(aenc(~kgu.1, pk(~eskU))), ~muG, ~T3>),
                           ~ltkS)
                 ) @ #vk.19 )
            case GS_3
            solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                                ~muU, ~T1>),
                             ~ltkS.1)
                   ) @ #vk.36 )
              case UE_1
              solve( !KU( sign(h(<
                                  <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                  ~muS, ~T2>),
                               ~ltkS.2)
