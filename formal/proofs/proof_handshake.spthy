                      case GS_3_case_1
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    next
                      case GS_3_case_2
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    next
                      case GS_3_case_3
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    next
                      case SAT_2_case_1
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    next
                      case SAT_2_case_2
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    next
                      case UE_1
                      by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

lemma sig_key_secret [reuse]:
  all-traces
  "∀ X k #i #j.
    ((SigKey( X, k ) @ #i) ∧ (!KU( k ) @ #j)) ⇒
    (∃ #r. (RevSig( X ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ X k #i #j.
  (SigKey( X, k ) @ #i) ∧ (!KU( k ) @ #j)
 ∧
  ∀ #r. (RevSig( X ) @ #r) ⇒ ¬(#r < #j)"
*/
simplify
solve( SigKey( X, k ) @ #i )
  case Enroll_GS
  solve( !KU( ~ltkS ) @ #j )
    case Reveal_Sig_GS
    by contradiction /* from formulas */
  qed
next
  case Enroll_SAT
  solve( !KU( ~ltkS ) @ #j )
    case Reveal_Sig_SAT
    by contradiction /* from formulas */
  qed
next
  case Enroll_UE
  solve( !KU( ~ltkS ) @ #j )
    case Reveal_Sig_UE
    by contradiction /* from formulas */
  qed
qed

lemma kem_key_secret [reuse]:
  all-traces
  "∀ X k #i #j.
    ((KemKey( X, k ) @ #i) ∧ (!KU( k ) @ #j)) ⇒
    (∃ #r. (RevKem( X ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ X k #i #j.
  (KemKey( X, k ) @ #i) ∧ (!KU( k ) @ #j)
 ∧
  ∀ #r. (RevKem( X ) @ #r) ⇒ ¬(#r < #j)"
*/
simplify
solve( KemKey( X, k ) @ #i )
  case Enroll_GS
  solve( !KU( ~ltkK ) @ #j )
    case Reveal_Kem_GS
    by contradiction /* from formulas */
  qed
next
  case Enroll_SAT
  solve( !KU( ~ltkK ) @ #j )
    case Reveal_Kem_SAT
    by contradiction /* from formulas */
  qed
next
  case Enroll_UE
  solve( !KU( ~ltkK ) @ #j )
    case Reveal_Kem_UE
    by contradiction /* from formulas */
  qed
qed

lemma gs_secret_kgs [reuse, heuristic={macfirst}]:
  all-traces
  "∀ G U S kgs kgu #i #j.
    ((GSKeys( G, U, S, kgs, kgu ) @ #i) ∧ (!KU( kgs ) @ #j)) ⇒
    (((((∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i)) ∨
        (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ #r. RevKgs( kgs ) @ #r)) ∨
     (∃ #r. RevKgu( kgu ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ G U S kgs kgu #i #j.
  (GSKeys( G, U, S, kgs, kgu ) @ #i) ∧ (!KU( kgs ) @ #j)
 ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKgs( kgs ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKgu( kgu ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !KU( mac(kdf(sssg),
                h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                   h(epkS), h(esu), muS, T2>))
       ) @ #vk.26 )
