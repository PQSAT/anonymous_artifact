lemma agree_kem_ue_sat [heuristic={kemmode}, hide_lemma=gs_secret_kgs,
                        hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'UE', 'SAT', U, S, G, sk ) @ #i) ⇒
    ((((∃ #j.
         ((Running( 'SAT', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
         (¬(∃ U2 S2 G2 #i2.
             (Commit( 'UE', 'SAT', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
       (∃ #r. RevKem( U ) @ #r)) ∨
      (∃ #r. RevKem( S ) @ #r)) ∨
     (∃ #r. RevKem( G ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'UE', 'SAT', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'SAT', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'UE', 'SAT', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'UE', 'SAT', U, S, G, sk ) @ #i )
  case UE_8
  solve( UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG, Pi2, Pi3,
                 mac(kdf(sssg), h(Pi2))
         ) ▶₁ #i )
    case UE_5
    solve( !KU( mac(kdf(sssg),
                    h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                       hcsg, hepkS, h(aenc(ksu, pk(~eskU))), muS, T2>))
           ) @ #vk.18 )
      case SAT_2
      solve( !KU( mac(kdf(ssgu),
                      h(<
                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                          h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                          ~muS, ~T2>, 
                         $G, h(aenc(ssgu, pk(~ltkK.2))), hegs, h(aenc(kgu, pk(~eskU))), muG, T3>))
             ) @ #vk.31 )
        case GS_3
        solve( !KU( mac(kdf(~ssus),
                        h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>))
               ) @ #vk.53 )
          case UE_1
          solve( !KU( senc(<'wrap-gs-u', kgs, ~sssg>,
                           kdf(<~kgu, ~ssgu, 'wrap-gu'>))
                 ) @ #vk.9 )
            case GS_7
            solve( !KU( h(<
                           kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                $G, 
                                <
                                 <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                  ~muS, ~T2>, 
                                 $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                 h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                'SK'>), 
                           ~muU, ~muS, ~muG, 'GS-fin'>)
                   ) @ #vk.15 )
              case GS_7
              solve( !KU( h(<
