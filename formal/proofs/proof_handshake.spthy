lemma executable:
  exists-trace
  "∃ U S G sk #i #j #k #l #m.
    ((((((((((SKey( 'UE', U, S, G, sk ) @ #i) ∧
             (SKey( 'SAT', U, S, G, sk ) @ #j)) ∧
            (SKey( 'GS', U, S, G, sk ) @ #k)) ∧
           (Done( 'SAT', U, S, G, sk ) @ #l)) ∧
          (Done( 'GS', U, S, G, sk ) @ #m)) ∧
         (¬(∃ X #r. RevSig( X ) @ #r))) ∧
        (¬(∃ X #r. RevKem( X ) @ #r))) ∧
       (¬(∃ e #r. RevEph( e ) @ #r))) ∧
      (¬(∃ e #r. RevKsu( e ) @ #r))) ∧
     (¬(∃ e #r. RevKgs( e ) @ #r))) ∧
    (¬(∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ U S G sk #i #j #k #l #m.
  (SKey( 'UE', U, S, G, sk ) @ #i) ∧
  (SKey( 'SAT', U, S, G, sk ) @ #j) ∧
  (SKey( 'GS', U, S, G, sk ) @ #k) ∧
  (Done( 'SAT', U, S, G, sk ) @ #l) ∧
  (Done( 'GS', U, S, G, sk ) @ #m)
 ∧
  (∀ X #r. (RevSig( X ) @ #r) ⇒ ⊥) ∧
  (∀ X #r. (RevKem( X ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKsu( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( SKey( 'UE', U, S, G, sk ) @ #i )
  case UE_8
  solve( UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG, Pi2, Pi3,
                 mac(kdf(sssg), h(Pi2))
         ) ▶₁ #i )
    case UE_5
    solve( SKey( 'SAT', $U, $S, $G,
                 kdf(<ksu, kgs, kgu, ~ssus, sssg, ssgu, ~muU, muS, muG, $U, $S, $G, 
                      <
                       <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                        hcsg, hepkS, h(aenc(ksu, pk(~eskU))), muS, T2>, 
                       $G, h(aenc(ssgu, pk(~ltkK.1))), hegs, h(aenc(kgu, pk(~eskU))), muG, T3>, 
                      'SK'>)
           ) @ #j )
      case SAT_7
      solve( SAT_St6( $S, $U, $G, ksu, kgs, ~ssus, sssg, ~muU, muS, muG,
                      <
                       <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                        hcsg, hepkS, h(aenc(ksu, pk(~eskU))), muS, T2>, 
                       $G, h(aenc(ssgu, pk(~ltkK.1))), hegs, h(aenc(kgu, pk(~eskU))), muG, T3>,
                      mac(kdf(ssgu),
                          h(<
