lemma R0_both_keys_of_one_party [heuristic={kemmode},
                                 hide_lemma=gs_secret_kgs, hide_lemma=gs_secret_kgu]:
  exists-trace
  "∃ U S G muU sk #a #i #j.
    ((((((((((((((UE_Start( U, S, G, muU ) @ #a) ∧
                 (SKey( 'GS', U, S, G, sk ) @ #i)) ∧
                (K( sk ) @ #j)) ∧
               (¬(∃ S2 X G2 muX epk #r. SAT_AcceptMsg1( S2, X, G2, muX, epk ) @ #r))) ∧
              (∀ U2 S2 G2 m #x. (UE_Start( U2, S2, G2, m ) @ #x) ⇒ (#x = #a))) ∧
             (∀ G2 U2 S2 m1 m2 #x.
               (GS_AcceptMsg2( G2, U2, S2, m1, m2 ) @ #x) ⇒
               (((U2 = U) ∧ (S2 = S)) ∧ (G2 = G)))) ∧
            (¬(U = S))) ∧
           (¬(S = G))) ∧
          (¬(U = G))) ∧
         (∀ X #r. (RevSig( X ) @ #r) ⇒ (X = S))) ∧
        (∀ X #r. (RevKem( X ) @ #r) ⇒ (X = S))) ∧
       (¬(∃ e #r. RevEph( e ) @ #r))) ∧
      (¬(∃ e #r. RevKsu( e ) @ #r))) ∧
     (¬(∃ e #r. RevKgs( e ) @ #r))) ∧
    (¬(∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ U S G muU sk #a #i #j.
  (UE_Start( U, S, G, muU ) @ #a) ∧
  (SKey( 'GS', U, S, G, sk ) @ #i) ∧
  (K( sk ) @ #j)
 ∧
  (∀ S2 X G2 muX epk #r.
    (SAT_AcceptMsg1( S2, X, G2, muX, epk ) @ #r) ⇒ ⊥) ∧
  (∀ U2 S2 G2 m #x. (UE_Start( U2, S2, G2, m ) @ #x) ⇒ #x = #a) ∧
  (∀ G2 U2 S2 m1 m2 #x.
    (GS_AcceptMsg2( G2, U2, S2, m1, m2 ) @ #x)
   ⇒
    (U2 = U) ∧ (S2 = S) ∧ (G2 = G)) ∧
  (¬(U = S)) ∧
  (¬(S = G)) ∧
  (¬(U = G)) ∧
  (∀ X #r. (RevSig( X ) @ #r) ⇒ X = S) ∧
  (∀ X #r. (RevKem( X ) @ #r) ⇒ X = S) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKsu( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !LtkSigU( $U, ltkSU ) ▶₄ #a )
  case Enroll_UE
  solve( !PkKemS( $S, pkKS ) ▶₅ #a )
    case Enroll_SAT
    solve( SKey( 'GS', $U, $S, $G, sk ) @ #i )
      case GS_7
      solve( !KU( kdf(<ksu, kgs, kgu, ssus.1, sssg, ssgu, muU.1, muS, muG, $U, 
                       $S, $G, Pi3, 'SK'>)
             ) @ #vk )
