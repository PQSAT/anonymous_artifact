lemma agree_dsa_gs_ue [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'GS', 'UE', U, S, G, sk ) @ #i) ⇒
    (((((((∃ #j.
            ((Running( 'UE', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
            (¬(∃ U2 S2 G2 #i2.
                (Commit( 'GS', 'UE', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
          (∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i))) ∨
         (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
        (∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ e #r. RevKgs( e ) @ #r)) ∨
     (∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'GS', 'UE', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'UE', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'GS', 'UE', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'GS', 'UE', U, S, G, sk ) @ #i )
  case GS_8
  solve( GS_St7( $G, $U, $S, sk, muU, muS, muG ) ▶₁ #i )
    case GS_7
    solve( !KU( mac(kdf(sssg),
                    h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(~ltkK))), 
                       h(epkS), h(esu), muS, T2>))
           ) @ #vk.32 )
      case SAT_2
      solve( !KU( mac(kdf(ssus.1),
                      h(<$U, $S, $G, h(aenc(ssus.1, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.40 )
        case UE_1
        solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), 
                            h(pk(~eskU)), ~muU, ~T1>),
                         ~ltkS)
               ) @ #vk.25 )
          case UE_1
          solve( !KU( sign(h(<
                              <$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                              h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu.1, pk(~eskU))), 
                              ~muS, ~T2>),
                           ~ltkS.1)
                 ) @ #vk.39 )
            case SAT_2
            solve( !KU( h(<
                           kdf(<ksu, ~kgs, ~kgu, ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, $G, 
                                <
                                 <<$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu.1, pk(~eskU))), 
                                  ~muS, ~T2>, 
                                 $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                 h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                'SK'>), 
                           ~muU, ~muS, ~muG, 'UE-fin-final'>)
                   ) @ #vk.11 )
              case UE_8
              solve( !KU( mac(kdf(~ssgu),
                              h(<
                                 <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                  ~muS, ~T2>, 
                                 $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                 h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>))
                     ) @ #vk.66 )
                case GS_3
