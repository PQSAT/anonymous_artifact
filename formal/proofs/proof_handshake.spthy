lemma agree_dsa_ue_gs [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'UE', 'GS', U, S, G, sk ) @ #i) ⇒
    (((((((∃ #j.
            ((Running( 'GS', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
            (¬(∃ U2 S2 G2 #i2.
                (Commit( 'UE', 'GS', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
          (∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i))) ∨
         (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
        (∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ e #r. RevKgs( e ) @ #r)) ∨
     (∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'UE', 'GS', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'GS', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'UE', 'GS', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'UE', 'GS', U, S, G, sk ) @ #i )
  case UE_8
  solve( UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG, Pi2, Pi3,
                 mac(kdf(sssg), h(Pi2))
         ) ▶₁ #i )
