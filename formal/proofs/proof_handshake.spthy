lemma agree_kem_sat_gs [heuristic={kemmode}, hide_lemma=gs_secret_kgs,
                        hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'SAT', 'GS', U, S, G, sk ) @ #i) ⇒
    ((((∃ #j.
         ((Running( 'GS', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
         (¬(∃ U2 S2 G2 #i2.
             (Commit( 'SAT', 'GS', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
       (∃ #r. RevKem( U ) @ #r)) ∨
      (∃ #r. RevKem( S ) @ #r)) ∨
     (∃ #r. RevKem( G ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'SAT', 'GS', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'GS', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'SAT', 'GS', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'SAT', 'GS', U, S, G, sk ) @ #i )
  case SAT_7
  solve( SAT_St6( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG, Pi3,
                  mac(kdf(ssgu), h(Pi3))
         ) ▶₁ #i )
    case SAT_6
    solve( !KU( mac(kdf(ssgu),
                    h(<
                       <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                       >, 
                       $G, h(cgu), h(aenc(kgs, pk(~eskS))), h(egu), muG, T3>))
           ) @ #vk.16 )
      case GS_3
      solve( !KU( mac(kdf(ssus),
                      h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.34 )
        case UE_1
        solve( !KU( mac(kdf(~sssg),
                        h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                           h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                           ~muS, ~T2>))
               ) @ #vk.51 )
          case SAT_2
          solve( !KU( senc(<'wrap-gu-s', kgu, ~ssgu>,
                           kdf(<~kgs, ~sssg, 'wrap-sg'>))
                 ) @ #vk.7 )
            case GS_7
            solve( !KU( h(<
                           kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                $G, 
                                <
                                 <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                  ~muS, ~T2>, 
                                 $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                 h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                'SK'>), 
                           ~muU, ~muS, ~muG, 'GS-fin'>)
                   ) @ #vk.11 )
              case GS_7
              solve( (#i2 < #i)  ∥ (#i < #i2) )
                case case_1
                solve( Commit( 'SAT', 'GS', U2, S2, G2,
                               kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                    $G, 
                                    <
                                     <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                      h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                      ~muS, ~T2>, 
                                     $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                     h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                    'SK'>)
                       ) @ #i2 )
                  case SAT_7
                  solve( SAT_St6( $S, $U, $G, ~ksu, ~kgs, ~ssus, ~sssg, ~muU, ~muS, ~muG,
                                  <
                                   <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                    h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                    ~muS, ~T2>, 
                                   $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                   h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>,
                                  mac(kdf(~ssgu),
                                      h(<
                                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                          $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                          h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                         $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                         h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>))
                         ) ▶₁ #i2 )
                    case SAT_6
                    by contradiction /* cyclic */
                  qed
                qed
              next
                case case_2
                solve( Commit( 'SAT', 'GS', U2, S2, G2,
                               kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                    $G, 
                                    <
                                     <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                      h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                      ~muS, ~T2>, 
                                     $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                     h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                    'SK'>)
                       ) @ #i2 )
                  case SAT_7
                  solve( SAT_St6( $S, $U, $G, ~ksu, ~kgs, ~ssus, ~sssg, ~muU, ~muS, ~muG,
                                  <
                                   <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                    h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                    ~muS, ~T2>, 
                                   $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                   h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>,
                                  mac(kdf(~ssgu),
                                      h(<
                                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                          $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                          h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                         $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                         h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>))
                         ) ▶₁ #i2 )
                    case SAT_6
                    by contradiction /* cyclic */
                  qed
                qed
              qed
            next
              case c_h
              solve( !KU( kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, 
                               ~muG, $U, $S, $G, 
                               <
                                <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                 h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                 ~muS, ~T2>, 
                                $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                               'SK'>)
                     ) @ #vk.59 )
                case c_kdf
                solve( (∃ #r. (RevKem( $U ) @ #r))  ∥ (∃ #r. (RevKem( $S ) @ #r))  ∥
                       (∃ #r. (RevKem( $G ) @ #r)) )
                  case case_1
                  by contradiction /* from formulas */
                next
                  case case_2
                  by contradiction /* from formulas */
                next
                  case case_3
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case c_senc
            solve( !KU( kdf(<~kgs, ~sssg, 'wrap-sg'>) ) @ #vk.53 )
              case c_kdf
              solve( (∃ #r. (RevKem( $U ) @ #r))  ∥ (∃ #r. (RevKem( $S ) @ #r))  ∥
                     (∃ #r. (RevKem( $G ) @ #r)) )
                case case_1
