lemma secrecy_dsa [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ R U S G sk #i.
    (((((((SKey( R, U, S, G, sk ) @ #i) ∧
          (¬(∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i)))) ∧
         (¬(∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i)))) ∧
        (¬(∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i)))) ∧
       (¬(∃ e #r. RevEph( e ) @ #r))) ∧
      (¬(∃ e #r. RevKgs( e ) @ #r))) ∧
     (¬(∃ e #r. RevKgu( e ) @ #r))) ⇒
    (¬(∃ #j. K( sk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R U S G sk #i.
  (SKey( R, U, S, G, sk ) @ #i)
 ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥) ∧
  (∃ #j. (K( sk ) @ #j))"
*/
simplify
solve( SKey( R, U, S, G, sk ) @ #i )
  case GS_7
  solve( !KU( kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, 
                   $G, Pi3, 'SK'>)
         ) @ #vk )
    case c_kdf
    solve( GS_St3( $G, $U, $S, kgs, kgu, ssgu, sssg, muU, muS, muG, Pi3
           ) ▶₁ #i )
      case GS_3
      solve( !KU( mac(kdf(sssg),
                      h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(~ltkK))), 
                         h(epkS), h(esu), muS, T2>))
             ) @ #vk.62 )
        case SAT_2
        solve( !KU( mac(kdf(ssus.1),
                        h(<$U, $S, $G, h(aenc(ssus.1, pk(~ltkK))), h(epkU), muU, T1>))
               ) @ #vk.86 )
          case UE_1
          solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), 
                              h(pk(~eskU)), ~muU, ~T1>),
                           ~ltkS)
                 ) @ #vk.67 )
            case UE_1
            solve( !KU( sign(h(<
                                <$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu.1, pk(~eskU))), 
                                ~muS, ~T2>),
                             ~ltkS.1)
                   ) @ #vk.77 )
              case SAT_2
              solve( (∃ #r. (RevSig( $U ) @ #r) ∧ #r < #vr)  ∥
                     (∃ #r. (RevSig( $S ) @ #r) ∧ #r < #vr)  ∥ (∃ e #r. (RevEph( e ) @ #r))  ∥
                     (∃ #r. (RevKgs( ~kgs ) @ #r))  ∥ (∃ #r. (RevKgu( ~kgu ) @ #r)) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              next
                case case_4
                by contradiction /* from formulas */
              next
                case case_5
                by contradiction /* from formulas */
              qed
            next
              case c_sign
              by contradiction /* from formulas */
            qed
          next
            case c_sign
            by contradiction /* from formulas */
          qed
        next
          case c_mac
