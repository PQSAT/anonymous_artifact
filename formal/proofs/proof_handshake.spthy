theory PQSAT_Handshake begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, kdf/1, mac/2, pair/2, pk/1,
           sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: macfirst
presort: s
prio: {id}
  regex"!KU\(~ltk"
prio: {id}
  regex"!KU\(~esk"
prio: {id}
  regex"!KU\(kdf\("
prio: {id}
  regex"!KU\(mac\("
prio: {id}
  regex"!KU\(sign\("


tactic: kemmode
presort: s
prio: {id}
  regex"!KU\(~ltk"
prio: {id}
  regex"!KU\(kdf\("
prio: {id}
  regex"!KU\(mac\("
deprio: {id}
  regex"!KU\(sign\("













rule (modulo E) Enroll_UE:
   [ Fr( ~ltkS ), Fr( ~ltkK ) ]
  --[ Enrolled( $X ), SigKey( $X, ~ltkS ), KemKey( $X, ~ltkK ) ]->
   [
   !LtkSigU( $X, ~ltkS ), !LtkKemU( $X, ~ltkK ), !PkSigU( $X, pk(~ltkS) ),
   !PkKemU( $X, pk(~ltkK) ), Out( pk(~ltkS) ), Out( pk(~ltkK) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Enroll_SAT:
   [ Fr( ~ltkS ), Fr( ~ltkK ) ]
  --[ Enrolled( $X ), SigKey( $X, ~ltkS ), KemKey( $X, ~ltkK ) ]->
   [
   !LtkSigS( $X, ~ltkS ), !LtkKemS( $X, ~ltkK ), !PkSigS( $X, pk(~ltkS) ),
   !PkKemS( $X, pk(~ltkK) ), Out( pk(~ltkS) ), Out( pk(~ltkK) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Enroll_GS:
   [ Fr( ~ltkS ), Fr( ~ltkK ) ]
  --[ Enrolled( $X ), SigKey( $X, ~ltkS ), KemKey( $X, ~ltkK ) ]->
   [
   !LtkSigG( $X, ~ltkS ), !LtkKemG( $X, ~ltkK ), !PkSigG( $X, pk(~ltkS) ),
   !PkKemG( $X, pk(~ltkK) ), Out( pk(~ltkS) ), Out( pk(~ltkK) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Sig_UE:
   [ !LtkSigU( $X, ltkS ) ] --[ RevSig( $X ) ]-> [ Out( ltkS ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Kem_UE:
   [ !LtkKemU( $X, ltkK ) ] --[ RevKem( $X ) ]-> [ Out( ltkK ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Sig_SAT:
   [ !LtkSigS( $X, ltkS ) ] --[ RevSig( $X ) ]-> [ Out( ltkS ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Kem_SAT:
   [ !LtkKemS( $X, ltkK ) ] --[ RevKem( $X ) ]-> [ Out( ltkK ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Sig_GS:
   [ !LtkSigG( $X, ltkS ) ] --[ RevSig( $X ) ]-> [ Out( ltkS ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Kem_GS:
   [ !LtkKemG( $X, ltkK ) ] --[ RevKem( $X ) ]-> [ Out( ltkK ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Eph:
   [ !Eph( esk ) ] --[ RevEph( esk ) ]-> [ Out( esk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ksu:
   [ !SecKsu( k ) ] --[ RevKsu( k ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Kgs:
   [ !SecKgs( k ) ] --[ RevKgs( k ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Kgu:
   [ !SecKgu( k ) ] --[ RevKgu( k ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) UE_1:
   [
   Fr( ~ssus ), Fr( ~eskU ), Fr( ~muU ), Fr( ~T1 ), !LtkSigU( $U, ltkSU ),
   !PkKemS( $S, pkKS )
   ]
  --[
  UE_Start( $U, $S, $G, ~muU ), SrcOut( ~ssus ),
  AuthSecret( $U, $S, $G, ~ssus )
  ]->
   [
   UE_St1( $U, $S, $G, ~eskU, ~ssus, ~muU,
           <$U, $S, $G, h(aenc(~ssus, pkKS)), h(pk(~eskU)), ~muU, ~T1>
   ),
   !Eph( ~eskU ), Out( aenc(~ssus, pkKS) ), Out( pk(~eskU) ), Out( ~muU ),
   Out( ~T1 ),
   Out( sign(h(<$U, $S, $G, h(aenc(~ssus, pkKS)), h(pk(~eskU)), ~muU, ~T1>),
             ltkSU)
   ),
   Out( mac(kdf(~ssus),
            h(<$U, $S, $G, h(aenc(~ssus, pkKS)), h(pk(~eskU)), ~muU, ~T1>))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SAT_2:
   [
   In( <$U, aenc(ssus, pk(ltkKS)), epkU, muU, T1, sigU, tauU> ), Fr( ~ksu ),
   Fr( ~eskS ), Fr( ~sssg ), Fr( ~muS ), Fr( ~T2 ), !PkSigU( $U, pkSU ),
   !LtkKemS( $S, ltkKS ), !LtkSigS( $S, ltkSS ), !PkKemG( $G, pkKG )
   ]
  --[
  Eq( verify(sigU,
             h(<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>), pkSU),
      true
  ),
  Eq( tauU,
      mac(kdf(ssus),
          h(<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>))
  ),
  SrcIn( ssus ), SrcOut( ~sssg ), SrcOut( ~ksu ),
  AuthSecret( $U, $S, $G, ~sssg ), SAT_AcceptMsg1( $S, $U, $G, muU, epkU )
  ]->
   [
   SAT_St2( $S, $U, $G, ~ksu, ~eskS, ssus, ~sssg, muU, ~muS,
            <<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, $S, 
             h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>
   ),
   !Eph( ~eskS ), !SecKsu( ~ksu ), Out( aenc(~sssg, pkKG) ),
   Out( pk(~eskS) ), Out( aenc(~ksu, epkU) ), Out( ~muS ), Out( ~T2 ),
   Out( sign(h(<<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, 
                $S, h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>),
             ltkSS)
   ),
   Out( mac(kdf(~sssg),
            h(<<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, $S, 
               h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>))
   )
   ]

  /*
  rule (modulo AC) SAT_2:
     [
     In( <$U, aenc(ssus, pk(ltkKS)), epkU, muU, T1, sigU, tauU> ), Fr( ~ksu ),
     Fr( ~eskS ), Fr( ~sssg ), Fr( ~muS ), Fr( ~T2 ), !PkSigU( $U, pkSU ),
     !LtkKemS( $S, ltkKS ), !LtkSigS( $S, ltkSS ), !PkKemG( $G, pkKG )
     ]
    --[
    Eq( z, true ),
    Eq( tauU,
        mac(kdf(ssus),
            h(<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>))
    ),
    SrcIn( ssus ), SrcOut( ~sssg ), SrcOut( ~ksu ),
    AuthSecret( $U, $S, $G, ~sssg ), SAT_AcceptMsg1( $S, $U, $G, muU, epkU )
    ]->
     [
     SAT_St2( $S, $U, $G, ~ksu, ~eskS, ssus, ~sssg, muU, ~muS,
              <<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, $S, 
               h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>
     ),
     !Eph( ~eskS ), !SecKsu( ~ksu ), Out( aenc(~sssg, pkKG) ),
     Out( pk(~eskS) ), Out( aenc(~ksu, epkU) ), Out( ~muS ), Out( ~T2 ),
     Out( sign(h(<<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, 
                  $S, h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>),
               ltkSS)
     ),
     Out( mac(kdf(~sssg),
              h(<<$U, $S, $G, h(aenc(ssus, pk(ltkKS))), h(epkU), muU, T1>, $S, 
                 h(aenc(~sssg, pkKG)), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2>))
     )
     ]
    variants (modulo AC)
    1. $G    = $G.20
       $S    = $S.20
       $U    = $U.20
       T1    = T1.20
       epkU  = epkU.20
       ltkKS = ltkKS.20
       muU   = muU.20
       pkSU  = pkSU.20
       sigU  = sigU.20
       ssus  = ssus.20
       z     = verify(sigU.20,
                      h(<$U.20, $S.20, $G.20, h(aenc(ssus.20, pk(ltkKS.20))), h(epkU.20), 
                         muU.20, T1.20>),
                      pkSU.20)
    
    2. $G    = $x.20
       $S    = $x.21
       $U    = $x.22
       T1    = x.28
       epkU  = x.29
       ltkKS = x.30
       muU   = x.32
       pkSU  = pk(x.34)
       sigU  = sign(h(<$x.22, $x.21, $x.20, h(aenc(x.35, pk(x.30))), h(x.29), 
                       x.32, x.28>),
                    x.34)
       ssus  = x.35
       z     = true
  */

rule (modulo E) GS_3:
   [
   In( <$U, hcus, epkU, muU, T1, sigU, $S, aenc(sssg, pk(ltkKG)), epkS, 
        esu, muS, T2, sigS, tauS>
   ),
   Fr( ~kgs ), Fr( ~kgu ), Fr( ~ssgu ), Fr( ~muG ), Fr( ~T3 ),
   !PkSigU( $U, pkSU ), !PkKemU( $U, pkKU ), !PkSigS( $S, pkSS ),
   !LtkKemG( $G, ltkKG ), !LtkSigG( $G, ltkSG )
   ]
  --[
  Eq( verify(sigU, h(<$U, $S, $G, hcus, h(epkU), muU, T1>), pkSU), true ),
  Eq( verify(sigS,
             h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                h(epkS), h(esu), muS, T2>),
             pkSS),
      true
  ),
  Eq( tauS,
      mac(kdf(sssg),
          h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
             h(epkS), h(esu), muS, T2>))
  ),
  SrcIn( sssg ), SrcOut( ~kgs ), SrcOut( ~kgu ), SrcOut( ~ssgu ),
  GSKeys( $G, $U, $S, ~kgs, ~kgu ), AuthSecret( $U, $S, $G, ~ssgu ),
  GS_AcceptMsg2( $G, $U, $S, muU, muS )
  ]->
   [
   GS_St3( $G, $U, $S, ~kgs, ~kgu, ~ssgu, sssg, muU, muS, ~muG,
           <
            <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
             h(epkS), h(esu), muS, T2>, 
            $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
            ~muG, ~T3>
   ),
   !SecKgs( ~kgs ), !SecKgu( ~kgu ), Out( aenc(~ssgu, pkKU) ),
   Out( aenc(~kgs, epkS) ), Out( aenc(~kgu, epkU) ), Out( ~muG ),
   Out( ~T3 ),
   Out( sign(h(<
                <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                 h(epkS), h(esu), muS, T2>, 
                $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
                ~muG, ~T3>),
             ltkSG)
   ),
   Out( mac(kdf(~ssgu),
            h(<
               <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                h(epkS), h(esu), muS, T2>, 
               $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
               ~muG, ~T3>))
   )
   ]

  /*
  rule (modulo AC) GS_3:
     [
     In( <$U, hcus, epkU, muU, T1, sigU, $S, aenc(sssg, pk(ltkKG)), epkS, 
          esu, muS, T2, sigS, tauS>
     ),
     Fr( ~kgs ), Fr( ~kgu ), Fr( ~ssgu ), Fr( ~muG ), Fr( ~T3 ),
     !PkSigU( $U, pkSU ), !PkKemU( $U, pkKU ), !PkSigS( $S, pkSS ),
     !LtkKemG( $G, ltkKG ), !LtkSigG( $G, ltkSG )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ),
    Eq( tauS,
        mac(kdf(sssg),
            h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
               h(epkS), h(esu), muS, T2>))
    ),
    SrcIn( sssg ), SrcOut( ~kgs ), SrcOut( ~kgu ), SrcOut( ~ssgu ),
    GSKeys( $G, $U, $S, ~kgs, ~kgu ), AuthSecret( $U, $S, $G, ~ssgu ),
    GS_AcceptMsg2( $G, $U, $S, muU, muS )
    ]->
     [
     GS_St3( $G, $U, $S, ~kgs, ~kgu, ~ssgu, sssg, muU, muS, ~muG,
             <
              <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
               h(epkS), h(esu), muS, T2>, 
              $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
              ~muG, ~T3>
     ),
     !SecKgs( ~kgs ), !SecKgu( ~kgu ), Out( aenc(~ssgu, pkKU) ),
     Out( aenc(~kgs, epkS) ), Out( aenc(~kgu, epkU) ), Out( ~muG ),
     Out( ~T3 ),
     Out( sign(h(<
                  <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                   h(epkS), h(esu), muS, T2>, 
                  $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
                  ~muG, ~T3>),
               ltkSG)
     ),
     Out( mac(kdf(~ssgu),
              h(<
                 <<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                  h(epkS), h(esu), muS, T2>, 
                 $G, h(aenc(~ssgu, pkKU)), h(aenc(~kgs, epkS)), h(aenc(~kgu, epkU)), 
                 ~muG, ~T3>))
     )
     ]
    variants (modulo AC)
    1. $G    = $G.28
       $S    = $S.28
       $U    = $U.28
       T1    = T1.28
       T2    = T2.28
       epkS  = epkS.28
       epkU  = epkU.28
       esu   = esu.28
       hcus  = hcus.28
       ltkKG = ltkKG.28
       muS   = muS.28
       muU   = muU.28
       pkSS  = pkSS.28
       pkSU  = pkSU.28
       sigS  = sigS.28
       sigU  = sigU.28
       sssg  = sssg.28
       z     = verify(sigU.28,
                      h(<$U.28, $S.28, $G.28, hcus.28, h(epkU.28), muU.28, T1.28>), pkSU.28)
       z.1   = verify(sigS.28,
                      h(<<$U.28, $S.28, $G.28, hcus.28, h(epkU.28), muU.28, T1.28>, $S.28, 
                         h(aenc(sssg.28, pk(ltkKG.28))), h(epkS.28), h(esu.28), muS.28, T2.28>),
                      pkSS.28)
    
    2. $G    = $x.28
       $S    = $x.29
       $U    = $x.30
       T1    = x.36
       T2    = x.37
       epkS  = x.38
       epkU  = x.39
       esu   = x.40
       hcus  = x.41
       ltkKG = x.42
       muS   = x.44
       muU   = x.45
       pkSS  = pk(x.47)
       pkSU  = pkSU.50
       sigS  = sign(h(<<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>, $x.29, 
                       h(aenc(x.49, pk(x.42))), h(x.38), h(x.40), x.44, x.37>),
                    x.47)
       sigU  = sigU.50
       sssg  = x.49
       z     = verify(sigU.50,
                      h(<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>), pkSU.50)
       z.1   = true
    
    3. $G    = $x.28
       $S    = $x.29
       $U    = $x.30
       T1    = x.36
       T2    = x.37
       epkS  = x.38
       epkU  = x.39
       esu   = x.40
       hcus  = x.41
       ltkKG = x.42
       muS   = x.44
       muU   = x.45
       pkSS  = pk(x.47)
       pkSU  = pk(x.48)
       sigS  = sign(h(<<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>, $x.29, 
                       h(aenc(x.49, pk(x.42))), h(x.38), h(x.40), x.44, x.37>),
                    x.47)
       sigU  = sign(h(<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>), x.48)
       sssg  = x.49
       z     = true
       z.1   = true
    
    4. $G    = $x.28
       $S    = $x.29
       $U    = $x.30
       T1    = x.36
       T2    = T2.49
       epkS  = epkS.49
       epkU  = x.39
       esu   = esu.49
       hcus  = x.41
       ltkKG = ltkKG.49
       muS   = muS.49
       muU   = x.45
       pkSS  = pkSS.49
       pkSU  = pk(x.48)
       sigS  = sigS.49
       sigU  = sign(h(<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>), x.48)
       sssg  = sssg.49
       z     = true
       z.1   = verify(sigS.49,
                      h(<<$x.30, $x.29, $x.28, x.41, h(x.39), x.45, x.36>, $x.29, 
                         h(aenc(sssg.49, pk(ltkKG.49))), h(epkS.49), h(esu.49), muS.49, T2.49>),
                      pkSS.49)
  */

rule (modulo E) SAT_4:
   [
   In( <cgu, aenc(kgs, pk(eskS)), egu, muG, T3, sigG, tauG> ),
   SAT_St2( $S, $U, $G, ksu, eskS, ssus, sssg, muU, muS, Pi2 ),
   !PkSigG( $G, pkSG )
   ]
  --[
  Eq( verify(sigG,
             h(<Pi2, $G, h(cgu), h(aenc(kgs, pk(eskS))), h(egu), muG, T3>), pkSG),
      true
  ),
  SAT_AcceptMsg3( $S, $U, $G, muU, muS, muG )
  ]->
   [
   SAT_St4( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG,
            <Pi2, $G, h(cgu), h(aenc(kgs, pk(eskS))), h(egu), muG, T3>,
            senc(<'wrap-su-g', ksu, ssus>, kdf(<kgs, sssg, 'wrap-sg'>)), tauG
   )
   ]

  /*
  rule (modulo AC) SAT_4:
     [
     In( <cgu, aenc(kgs, pk(eskS)), egu, muG, T3, sigG, tauG> ),
     SAT_St2( $S, $U, $G, ksu, eskS, ssus, sssg, muU, muS, Pi2 ),
     !PkSigG( $G, pkSG )
     ]
    --[ Eq( z, true ), SAT_AcceptMsg3( $S, $U, $G, muU, muS, muG ) ]->
     [
     SAT_St4( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG,
              <Pi2, $G, h(cgu), h(aenc(kgs, pk(eskS))), h(egu), muG, T3>,
              senc(<'wrap-su-g', ksu, ssus>, kdf(<kgs, sssg, 'wrap-sg'>)), tauG
     )
     ]
    variants (modulo AC)
    1. $G    = $G.37
       Pi2   = Pi2.40
       T3    = T3.41
       cgu   = cgu.42
       egu   = egu.43
       eskS  = eskS.44
       kgs   = kgs.45
       muG   = muG.47
       pkSG  = pkSG.50
       sigG  = sigG.51
       z     = verify(sigG.51,
                      h(<Pi2.40, $G.37, h(cgu.42), h(aenc(kgs.45, pk(eskS.44))), h(egu.43), 
                         muG.47, T3.41>),
                      pkSG.50)
    
    2. $G    = $G.57
       Pi2   = Pi2.60
       T3    = T3.61
       cgu   = cgu.62
       egu   = egu.63
       eskS  = eskS.64
       kgs   = kgs.65
       muG   = muG.67
       pkSG  = pk(x.112)
       sigG  = sign(h(<Pi2.60, $G.57, h(cgu.62), h(aenc(kgs.65, pk(eskS.64))), 
                       h(egu.63), muG.67, T3.61>),
                    x.112)
       z     = true
  */

rule (modulo E) UE_5:
   [
   In( <hcsg, hepkS, aenc(ksu, pk(eskU)), muS, T2, sigS, tauS, 
        aenc(ssgu, pk(ltkKU)), hegs, aenc(kgu, pk(eskU)), muG, T3, sigG, tauG>
   ),
   UE_St1( $U, $S, $G, eskU, ssus, muU, Pi1 ), !PkSigS( $S, pkSS ),
   !PkSigG( $G, pkSG ), !LtkKemU( $U, ltkKU )
   ]
  --[
  Eq( verify(sigS,
             h(<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>), pkSS),
      true
  ),
  Eq( verify(sigG,
             h(<<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>, $G, 
                h(aenc(ssgu, pk(ltkKU))), hegs, h(aenc(kgu, pk(eskU))), muG, T3>),
             pkSG),
      true
  ),
  Eq( tauG,
      mac(kdf(ssgu),
          h(<<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>, $G, 
             h(aenc(ssgu, pk(ltkKU))), hegs, h(aenc(kgu, pk(eskU))), muG, T3>))
  ),
  UE_AcceptMsg4( $U, $S, $G, muU, muS, muG )
  ]->
   [
   UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG,
           <Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>,
           <<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>, $G, 
            h(aenc(ssgu, pk(ltkKU))), hegs, h(aenc(kgu, pk(eskU))), muG, T3>,
           tauS
   ),
   Out( h(<ksu, kgu, ssus, ssgu, muU, muS, muG, 'UE-fin'>) )
   ]

  /*
  rule (modulo AC) UE_5:
     [
     In( <hcsg, hepkS, aenc(ksu, pk(eskU)), muS, T2, sigS, tauS, 
          aenc(ssgu, pk(ltkKU)), hegs, aenc(kgu, pk(eskU)), muG, T3, sigG, tauG>
     ),
     UE_St1( $U, $S, $G, eskU, ssus, muU, Pi1 ), !PkSigS( $S, pkSS ),
     !PkSigG( $G, pkSG ), !LtkKemU( $U, ltkKU )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ),
    Eq( tauG,
        mac(kdf(ssgu),
            h(<<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>, $G, 
               h(aenc(ssgu, pk(ltkKU))), hegs, h(aenc(kgu, pk(eskU))), muG, T3>))
    ),
    UE_AcceptMsg4( $U, $S, $G, muU, muS, muG )
    ]->
     [
     UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG,
             <Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>,
             <<Pi1, $S, hcsg, hepkS, h(aenc(ksu, pk(eskU))), muS, T2>, $G, 
              h(aenc(ssgu, pk(ltkKU))), hegs, h(aenc(kgu, pk(eskU))), muG, T3>,
             tauS
     ),
     Out( h(<ksu, kgu, ssus, ssgu, muU, muS, muG, 'UE-fin'>) )
     ]
    variants (modulo AC)
    1. $G    = $G.29
       $S    = $S.30
       Pi1   = Pi1.32
       T2    = T2.33
       T3    = T3.34
       eskU  = eskU.35
       hcsg  = hcsg.36
       hegs  = hegs.37
       hepkS = hepkS.38
       kgu   = kgu.39
       ksu   = ksu.40
       ltkKU = ltkKU.41
       muG   = muG.42
       muS   = muS.43
       pkSG  = pkSG.45
       pkSS  = pkSS.46
       sigG  = sigG.47
       sigS  = sigS.48
       ssgu  = ssgu.49
       z     = verify(sigS.48,
                      h(<Pi1.32, $S.30, hcsg.36, hepkS.38, h(aenc(ksu.40, pk(eskU.35))), 
                         muS.43, T2.33>),
                      pkSS.46)
       z.1   = verify(sigG.47,
                      h(<
                         <Pi1.32, $S.30, hcsg.36, hepkS.38, h(aenc(ksu.40, pk(eskU.35))), muS.43, 
                          T2.33>, 
                         $G.29, h(aenc(ssgu.49, pk(ltkKU.41))), hegs.37, 
                         h(aenc(kgu.39, pk(eskU.35))), muG.42, T3.34>),
                      pkSG.45)
    
    2. $G    = $G.46
       $S    = $S.47
       Pi1   = Pi1.49
       T2    = T2.50
       T3    = T3.51
       eskU  = eskU.52
       hcsg  = hcsg.53
       hegs  = hegs.54
       hepkS = hepkS.55
       kgu   = kgu.56
       ksu   = ksu.57
       ltkKU = ltkKU.58
       muG   = muG.59
       muS   = muS.60
       pkSG  = pkSG.62
       pkSS  = pk(x.89)
       sigG  = sigG.64
       sigS  = sign(h(<Pi1.49, $S.47, hcsg.53, hepkS.55, 
                       h(aenc(ksu.57, pk(eskU.52))), muS.60, T2.50>),
                    x.89)
       ssgu  = ssgu.66
       z     = true
       z.1   = verify(sigG.64,
                      h(<
                         <Pi1.49, $S.47, hcsg.53, hepkS.55, h(aenc(ksu.57, pk(eskU.52))), muS.60, 
                          T2.50>, 
                         $G.46, h(aenc(ssgu.66, pk(ltkKU.58))), hegs.54, 
                         h(aenc(kgu.56, pk(eskU.52))), muG.59, T3.51>),
                      pkSG.62)
    
    3. $G    = $G.47
       $S    = $S.48
       Pi1   = Pi1.50
       T2    = T2.51
       T3    = T3.52
       eskU  = eskU.53
       hcsg  = hcsg.54
       hegs  = hegs.55
       hepkS = hepkS.56
       kgu   = kgu.57
       ksu   = ksu.58
       ltkKU = ltkKU.59
       muG   = muG.60
       muS   = muS.61
       pkSG  = pk(x.90)
       pkSS  = pk(x.91)
       sigG  = sign(h(<
                       <Pi1.50, $S.48, hcsg.54, hepkS.56, h(aenc(ksu.58, pk(eskU.53))), muS.61, 
                        T2.51>, 
                       $G.47, h(aenc(ssgu.67, pk(ltkKU.59))), hegs.55, 
                       h(aenc(kgu.57, pk(eskU.53))), muG.60, T3.52>),
                    x.90)
       sigS  = sign(h(<Pi1.50, $S.48, hcsg.54, hepkS.56, 
                       h(aenc(ksu.58, pk(eskU.53))), muS.61, T2.51>),
                    x.91)
       ssgu  = ssgu.67
       z     = true
       z.1   = true
    
    4. $G    = $G.48
       $S    = $S.49
       Pi1   = Pi1.51
       T2    = T2.52
       T3    = T3.53
       eskU  = eskU.54
       hcsg  = hcsg.55
       hegs  = hegs.56
       hepkS = hepkS.57
       kgu   = kgu.58
       ksu   = ksu.59
       ltkKU = ltkKU.60
       muG   = muG.61
       muS   = muS.62
       pkSG  = pk(x.91)
       pkSS  = pkSS.65
       sigG  = sign(h(<
                       <Pi1.51, $S.49, hcsg.55, hepkS.57, h(aenc(ksu.59, pk(eskU.54))), muS.62, 
                        T2.52>, 
                       $G.48, h(aenc(ssgu.68, pk(ltkKU.60))), hegs.56, 
                       h(aenc(kgu.58, pk(eskU.54))), muG.61, T3.53>),
                    x.91)
       sigS  = sigS.67
       ssgu  = ssgu.68
       z     = verify(sigS.67,
                      h(<Pi1.51, $S.49, hcsg.55, hepkS.57, h(aenc(ksu.59, pk(eskU.54))), 
                         muS.62, T2.52>),
                      pkSS.65)
       z.1   = true
  */

rule (modulo E) SAT_6:
   [
   In( tagU ),
   SAT_St4( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG, Pi3, Csug, tauG
   )
   ]
  -->
   [
   SAT_St6( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG, Pi3, tauG ),
   Out( Csug )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) GS_7:
   [
   In( <senc(<'wrap-su-g', ksu, ssus>, kdf(<kgs, sssg, 'wrap-sg'>)), 
        h(<ksu, kgu, ssus, ssgu, muU, muS, muG, 'UE-fin'>)>
   ),
   GS_St3( $G, $U, $S, kgs, kgu, ssgu, sssg, muU, muS, muG, Pi3 )
   ]
  --[
  SKey( 'GS', $U, $S, $G,
        kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
             'SK'>)
  ),
  Running( 'GS', $U, $S, $G,
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>)
  )
  ]->
   [
   GS_St7( $G, $U, $S,
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>),
           muU, muS, muG
   ),
   Out( senc(<'wrap-gs-u', kgs, sssg>, kdf(<kgu, ssgu, 'wrap-gu'>)) ),
   Out( senc(<'wrap-gu-s', kgu, ssgu>, kdf(<kgs, sssg, 'wrap-sg'>)) ),
   Out( h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'GS-fin'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SAT_7:
   [
   In( <senc(<'wrap-gu-s', kgu, ssgu>, kdf(<kgs, sssg, 'wrap-sg'>)), 
        h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'GS-fin'>)
       >
   ),
   SAT_St6( $S, $U, $G, ksu, kgs, ssus, sssg, muU, muS, muG, Pi3, tauG )
   ]
  --[
  Eq( tauG, mac(kdf(ssgu), h(Pi3)) ),
  SKey( 'SAT', $U, $S, $G,
        kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
             'SK'>)
  ),
  Running( 'SAT', $U, $S, $G,
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>)
  ),
  Commit( 'SAT', 'GS', $U, $S, $G,
          kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
               'SK'>)
  )
  ]->
   [
   SAT_St7( $S, $U, $G,
            kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                 'SK'>),
            muU, muS, muG
   ),
   Out( h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'SAT-fin'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) UE_8:
   [
   In( <senc(<'wrap-gs-u', kgs, sssg>, kdf(<kgu, ssgu, 'wrap-gu'>)), 
        h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'GS-fin'>), 
        h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'SAT-fin'>)
       >
   ),
   UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG, Pi2, Pi3, tauS )
   ]
  --[
  Eq( tauS, mac(kdf(sssg), h(Pi2)) ),
  SKey( 'UE', $U, $S, $G,
        kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
             'SK'>)
  ),
  Running( 'UE', $U, $S, $G,
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>)
  ),
  Commit( 'UE', 'SAT', $U, $S, $G,
          kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
               'SK'>)
  ),
  Commit( 'UE', 'GS', $U, $S, $G,
          kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
               'SK'>)
  )
  ]->
   [
   Out( h(<
           kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, $G, Pi3, 
                'SK'>), 
           muU, muS, muG, 'UE-fin-final'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SAT_8:
   [
   In( h(<SK, muU, muS, muG, 'UE-fin-final'>) ),
   SAT_St7( $S, $U, $G, SK, muU, muS, muG )
   ]
  --[ Commit( 'SAT', 'UE', $U, $S, $G, SK ), Done( 'SAT', $U, $S, $G, SK )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) GS_8:
   [
   In( <h(<SK, muU, muS, muG, 'UE-fin-final'>), 
        h(<SK, muU, muS, muG, 'SAT-fin'>)>
   ),
   GS_St7( $G, $U, $S, SK, muU, muS, muG )
   ]
  --[
  Commit( 'GS', 'UE', $U, $S, $G, SK ),
  Commit( 'GS', 'SAT', $U, $S, $G, SK ), Done( 'GS', $U, $S, $G, SK )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction OneEnrollment:
  "∀ x #i #j. ((Enrolled( x ) @ #i) ∧ (Enrolled( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma types [sources]:
  all-traces
  "∀ x #i.
    (SrcIn( x ) @ #i) ⇒
    ((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
     (∃ #j. (SrcOut( x ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i.
  (SrcIn( x ) @ #i)
 ∧
  (∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (SrcOut( x ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#i))  ∥
         (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #j. (SrcOut( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( SrcIn( x ) @ #i )
      case GS_3
      solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
        case Enroll_UE
        solve( !PkKemU( $U, pkKU ) ▶₇ #i )
          case Enroll_UE
          solve( !PkSigS( $S, pk(x.1) ) ▶₈ #i )
            case Enroll_SAT
            solve( !LtkKemG( $G, ltkKG ) ▶₉ #i )
              case Enroll_GS
              solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                case Enroll_GS
                solve( !KU( sign(h(<$U, $S, $G, hcus, h(epkU), muU, T1>), ~ltkS)
                       ) @ #vk.11 )
                  case GS_7
                  solve( (∃ #j. (!KU( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.7))  ∥
                         (∃ #j. (SrcOut( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.7)) )
                    case case_1
                    by contradiction /* cyclic */
                  next
                    case case_2
                    solve( SrcOut( sssg ) @ #j )
                      case GS_3_case_1
                      by contradiction /* impossible chain */
                    next
                      case GS_3_case_2
                      by contradiction /* impossible chain */
                    next
                      case GS_3_case_3
                      by contradiction /* impossible chain */
                    next
                      case SAT_2_case_1
                      by contradiction /* impossible chain */
                    next
                      case SAT_2_case_2
                      by contradiction /* impossible chain */
                    next
                      case UE_1
                      by contradiction /* impossible chain */
                    qed
                  qed
                next
                  case SAT_6
                  solve( (∃ #j. (!KU( ssus ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8))  ∥
                         (∃ #j. (SrcOut( ssus ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8)) )
                    case case_1
                    by contradiction /* cyclic */
                  next
                    case case_2
                    solve( SrcOut( ssus ) @ #j )
                      case GS_3_case_1
                      by contradiction /* impossible chain */
                    next
                      case GS_3_case_2
                      by contradiction /* impossible chain */
                    next
                      case GS_3_case_3
                      by contradiction /* impossible chain */
                    next
                      case SAT_2_case_1
                      by contradiction /* impossible chain */
                    next
                      case SAT_2_case_2
                      by contradiction /* impossible chain */
                    next
                      case UE_1
                      by contradiction /* impossible chain */
                    qed
                  qed
                next
                  case UE_1
                  solve( !KU( ~muU ) @ #vk.8 )
                    case GS_7
                    solve( (∃ #j. (!KU( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8))  ∥
                           (∃ #j. (SrcOut( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8)) )
                      case case_1
                      by contradiction /* cyclic */
                    next
                      case case_2
                      solve( SrcOut( sssg ) @ #j )
                        case GS_3_case_1
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      next
                        case GS_3_case_2
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      next
                        case GS_3_case_3
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      next
                        case SAT_2_case_1
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      next
                        case SAT_2_case_2
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      next
                        case UE_1
                        by solve( (#vr.7, 0) ~~> (#vk.1, 0) )
                      qed
                    qed
                  next
                    case SAT_6
                    solve( (∃ #j. (!KU( ssus.1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.9))  ∥
                           (∃ #j. (SrcOut( ssus.1 ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.9)) )
                      case case_1
                      by contradiction /* cyclic */
                    next
                      case case_2
                      solve( SrcOut( ssus.1 ) @ #j )
                        case GS_3_case_1
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      next
                        case GS_3_case_2
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      next
                        case GS_3_case_3
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      next
                        case SAT_2_case_1
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      next
                        case SAT_2_case_2
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      next
                        case UE_1
                        by solve( (#vr.8, 0) ~~> (#vk.1, 0) )
                      qed
                    qed
                  next
                    case UE_1
                    solve( !KU( ~T1 ) @ #vk.11 )
                      case GS_7
                      solve( (∃ #j. (!KU( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8))  ∥
                             (∃ #j. (SrcOut( sssg ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.8)) )
                        case case_1
                        by contradiction /* cyclic */
                      next
                        case case_2
                        solve( SrcOut( sssg ) @ #j )
                          case GS_3_case_1
                          by solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                        next
                          case GS_3_case_2
                          by solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                        next
                          case GS_3_case_3
                          by solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                        next
                          case SAT_2_case_1
                          by solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                        next
                          case SAT_2_case_2
                          by solve( (#vr.7, 0) ~~> (#vk.2, 0) )
                        next
                          case UE_1
