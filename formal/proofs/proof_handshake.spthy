                                     kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                          $G, 
                                          <
                                           <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
