                    qed
                  next
                    case GS_7_case_1
                    solve( !KU( ~kgu ) @ #vk.40 )
                      case GS_3
                      solve( !KU( ~eskU ) @ #vk.44 )
                        case Reveal_Eph
                        by contradiction /* from formulas */
                      qed
                    next
                      case GS_7_case_1
