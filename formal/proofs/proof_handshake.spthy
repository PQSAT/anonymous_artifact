lemma agree_dsa_ue_sat [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'UE', 'SAT', U, S, G, sk ) @ #i) ⇒
    (((((((∃ #j.
            ((Running( 'SAT', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
            (¬(∃ U2 S2 G2 #i2.
                (Commit( 'UE', 'SAT', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
          (∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i))) ∨
         (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
        (∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ e #r. RevKgs( e ) @ #r)) ∨
     (∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'UE', 'SAT', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'SAT', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'UE', 'SAT', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'UE', 'SAT', U, S, G, sk ) @ #i )
  case UE_8
  solve( UE_St5( $U, $S, $G, ksu, kgu, ssus, ssgu, muU, muS, muG, Pi2, Pi3,
                 mac(kdf(sssg), h(Pi2))
         ) ▶₁ #i )
    case UE_5
    solve( !KU( mac(kdf(sssg),
                    h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                       hcsg, hepkS, h(aenc(ksu, pk(~eskU))), muS, T2>))
           ) @ #vk.18 )
      case SAT_2
      solve( !KU( mac(kdf(ssgu),
                      h(<
                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                          h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                          ~muS, ~T2>, 
                         $G, h(aenc(ssgu, pk(~ltkK.2))), hegs, h(aenc(kgu, pk(~eskU))), muG, T3>))
             ) @ #vk.31 )
        case GS_3
        solve( !KU( mac(kdf(~ssus),
                        h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>))
               ) @ #vk.53 )
          case UE_1
          solve( !KU( sign(h(<
                              <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                              h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                              ~muS, ~T2>),
                           ~ltkS)
                 ) @ #vk.26 )
            case SAT_2
            solve( !KU( sign(h(<
                                <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                 h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                 ~muS, ~T2>, 
                                $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs.1, pk(~eskS))), 
                                h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>),
                             ~ltkS.1)
                   ) @ #vk.39 )
              case GS_3
              solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                                  ~muU, ~T1>),
                               ~ltkS.2)
                     ) @ #vk.56 )
                case UE_1
                solve( !KU( senc(<'wrap-gs-u', kgs, ~sssg>,
                                 kdf(<~kgu, ~ssgu, 'wrap-gu'>))
                       ) @ #vk.24 )
                  case GS_7
                  solve( !KU( h(<
                                 kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                      $G, 
                                      <
                                       <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                        ~muS, ~T2>, 
                                       $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                       h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                      'SK'>), 
                                 ~muU, ~muS, ~muG, 'GS-fin'>)
                         ) @ #vk.31 )
                    case GS_7
                    solve( !KU( h(<
                                   kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                        $G, 
                                        <
                                         <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                          $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                          h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                         $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                         h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                        'SK'>), 
                                   ~muU, ~muS, ~muG, 'SAT-fin'>)
                           ) @ #vk.37 )
                      case SAT_7
                      solve( (#i2 < #i)  ∥ (#i < #i2) )
                        case case_1
                        solve( Commit( 'UE', 'SAT', U2, S2, G2,
                                       kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                            $G, 
                                            <
                                             <
                                              <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1
                                              >, 
                                              $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                              h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                             $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                             h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                            'SK'>)
                               ) @ #i2 )
                          case UE_8
                          solve( UE_St5( $U, $S, $G, ~ksu, ~kgu, ~ssus, ~ssgu, ~muU, ~muS, ~muG,
                                         Pi2,
                                         <
                                          <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                           $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                           h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                          $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                          h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>,
                                         mac(kdf(~sssg), h(Pi2))
                                 ) ▶₁ #i2 )
                            case UE_5
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case case_2
                        solve( Commit( 'UE', 'SAT', U2, S2, G2,
                                       kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                            $G, 
                                            <
                                             <
                                              <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1
                                              >, 
                                              $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                              h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                             $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                             h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                            'SK'>)
                               ) @ #i2 )
                          case UE_8
                          solve( UE_St5( $U, $S, $G, ~ksu, ~kgu, ~ssus, ~ssgu, ~muU, ~muS, ~muG,
                                         Pi2,
                                         <
                                          <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                           $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                           h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                          $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                          h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>,
                                         mac(kdf(~sssg), h(Pi2))
                                 ) ▶₁ #i2 )
                            case UE_5
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    next
                      case c_h
                      solve( !KU( kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, 
                                       ~muG, $U, $S, $G, 
                                       <
                                        <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, 
                                         $S, h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), 
                                         h(aenc(~ksu, pk(~eskU))), ~muS, ~T2>, 
                                        $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                        h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                       'SK'>)
                             ) @ #vk.69 )
                        case c_kdf
                        solve( (∃ #r. (RevSig( $U ) @ #r) ∧ #r < #vr.6)  ∥
                               (∃ #r. (RevSig( $S ) @ #r) ∧ #r < #vr.6)  ∥
                               (∃ e #r. (RevEph( e ) @ #r))  ∥ (∃ #r. (RevKgs( ~kgs ) @ #r))  ∥
                               (∃ #r. (RevKgu( ~kgu ) @ #r)) )
                          case case_1
                          by contradiction /* from formulas */
                        next
                          case case_2
                          by contradiction /* from formulas */
                        next
                          case case_3
                          by contradiction /* from formulas */
                        next
                          case case_4
                          by contradiction /* from formulas */
                        next
                          case case_5
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case c_h
                    solve( !KU( kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, 
                                     ~muG, $U, $S, $G, 
                                     <
                                      <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
