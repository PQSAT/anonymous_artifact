                        solve( !KU( mac(kdf(~sssg),
                                        h(<$U.1, $S.1, $G.1, h(aenc(~sssg, pk(~ltkK.3))), h(epkU), muU.1, T1.1
                                          >))
                               ) @ #vk.74 )
                          case c_mac
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case GS_7_case_2
                      solve( !KU( mac(kdf(~kgs),
                                      h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                         h(aenc(~kgs, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                             ) @ #vk.68 )
                        case c_mac
                        solve( !KU( kdf(~kgs) ) @ #vk.74 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case Reveal_Kgs
                      by contradiction /* from formulas */
                    next
                      case SAT_6
                      solve( !KU( mac(kdf(~kgs),
                                      h(<$U.1, $S.1, $G.1, h(aenc(~kgs, pk(~ltkK.3))), h(epkU), muU.1, T1.1>))
                             ) @ #vk.65 )
                        case c_mac
                        solve( !KU( kdf(~kgs) ) @ #vk.71 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case c_mac
          solve( !KU( kdf(~ssus) ) @ #vk.38 )
            case c_kdf
            solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
              case Enroll_UE
              solve( !PkKemU( $U, pkKU ) ▶₇ #i )
                case Enroll_UE
                solve( !PkSigS( $S, pk(~ltkS.1) ) ▶₈ #i )
                  case Enroll_SAT
                  solve( !LtkKemG( $G, ~ltkK.1 ) ▶₉ #i )
                    case Enroll_GS
                    solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                      case Enroll_GS
                      solve( !KU( ~kgs ) @ #j )
                        case GS_3
                        solve( !KU( ~eskS ) @ #vk.41 )
                          case Reveal_Eph
                          by contradiction /* from formulas */
                        qed
                      next
                        case GS_7_case_1
                        solve( !KU( ~sssg ) @ #vk.38 )
                          case GS_7
                          solve( !KU( mac(kdf(~sssg),
                                          h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                             h(aenc(~sssg, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                                 ) @ #vk.81 )
                            case c_mac
                            by contradiction /* cyclic */
                          qed
                        next
                          case SAT_2
                          solve( !KU( ~ltkK.1 ) @ #vk.50 )
                            case Reveal_Kem_GS
                            solve( RevKem( $G ) @ #r )
                              case Reveal_Kem_GS
                              solve( !LtkKemG( $G, ltkK.3 ) ▶₀ #r )
                                case Enroll_GS
                                solve( RevKem( $G ) @ #r.1 )
                                  case Reveal_Kem_GS
                                  solve( !LtkKemG( $G, ltkK.3 ) ▶₀ #r.1 )
                                    case Enroll_GS
                                    solve( !KU( ~ssus ) @ #vk.42 )
                                      case GS_7
                                      solve( !KU( mac(kdf(~ssus),
                                                      h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, 
                                                         $S.1, h(aenc(~ssus, pk(~ltkK.3))), h(epkS), h(esu), 
                                                         muS.1, T2.1>))
                                             ) @ #vk.82 )
                                        case c_mac
                                        by contradiction /* cyclic */
                                      qed
                                    next
                                      case SAT_6
                                      solve( !KU( mac(kdf(~ssus),
                                                      h(<$U.1, $S.1, $G.1, h(aenc(~ssus, pk(~ltkK.3))), 
                                                         h(epkU), muU.1, T1.1>))
                                             ) @ #vk.78 )
                                        case c_mac
                                        by contradiction /* cyclic */
                                      qed
                                    next
                                      case UE_1
                                      solve( !KU( ~ltkK ) @ #vk.51 )
                                        case Reveal_Kem_SAT
                                        solve( RevKem( $S ) @ #r.2 )
                                          case Reveal_Kem_GS
                                          by solve( !LtkKemG( $S, ltkK.3 ) ▶₀ #r.2 )
                                        next
                                          case Reveal_Kem_SAT
                                          solve( !LtkKemS( $S, ltkK.3 ) ▶₀ #r.2 )
                                            case Enroll_SAT
                                            solve( RevKem( $S ) @ #r.3 )
                                              case Reveal_Kem_GS
                                              by solve( !LtkKemG( $S, ltkK.3 ) ▶₀ #r.3 )
                                            next
                                              case Reveal_Kem_SAT
                                              solve( !LtkKemS( $S, ltkK.3 ) ▶₀ #r.3 )
                                                case Enroll_SAT
                                                solve( !KU( ~kgu ) @ #vk.48 )
                                                  case GS_3
                                                  solve( !KU( ~eskU ) @ #vk.52 )
                                                    case Reveal_Eph
                                                    by contradiction /* from formulas */
                                                  qed
                                                next
                                                  case GS_7_case_1
                                                  solve( !KU( mac(kdf(~kgu),
                                                                  h(<
                                                                     <$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, 
                                                                      T1.1>, 
                                                                     $S.1, h(aenc(~kgu, pk(~ltkK.3))), 
                                                                     h(epkS), h(esu), muS.1, T2.1>))
                                                         ) @ #vk.83 )
                                                    case c_mac
                                                    solve( !KU( kdf(~kgu) ) @ #vk.87 )
                                                      case c_kdf
                                                      by contradiction /* cyclic */
                                                    qed
                                                  qed
                                                next
                                                  case GS_7_case_2
                                                  by contradiction /* cyclic */
                                                next
                                                  case Reveal_Kgu
                                                  by contradiction /* from formulas */
                                                next
                                                  case SAT_6
                                                  solve( !KU( mac(kdf(~kgu),
                                                                  h(<$U.1, $S.1, $G.1, 
                                                                     h(aenc(~kgu, pk(~ltkK.3))), h(epkU), 
                                                                     muU.1, T1.1>))
                                                         ) @ #vk.79 )
                                                    case c_mac
                                                    solve( !KU( kdf(~kgu) ) @ #vk.85 )
                                                      case c_kdf
                                                      by contradiction /* cyclic */
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            next
                                              case Reveal_Kem_UE
                                              by solve( !LtkKemU( $S, ltkK.3 ) ▶₀ #r.3 )
                                            qed
                                          qed
                                        next
                                          case Reveal_Kem_UE
                                          by solve( !LtkKemU( $S, ltkK.3 ) ▶₀ #r.2 )
                                        qed
                                      qed
                                    qed
                                  qed
                                next
                                  case Reveal_Kem_SAT
                                  by solve( !LtkKemS( $G, ltkK.3 ) ▶₀ #r.1 )
                                next
                                  case Reveal_Kem_UE
                                  by solve( !LtkKemU( $G, ltkK.3 ) ▶₀ #r.1 )
                                qed
                              qed
                            next
                              case Reveal_Kem_SAT
                              by solve( !LtkKemS( $G, ltkK.3 ) ▶₀ #r )
                            next
                              case Reveal_Kem_UE
                              by solve( !LtkKemU( $G, ltkK.3 ) ▶₀ #r )
                            qed
                          qed
                        next
                          case SAT_6
                          solve( !KU( mac(kdf(~sssg),
                                          h(<$U.1, $S.1, $G.1, h(aenc(~sssg, pk(~ltkK.3))), h(epkU), muU.1, 
                                             T1.1>))
                                 ) @ #vk.77 )
                            case c_mac
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case GS_7_case_2
                        solve( !KU( mac(kdf(~kgs),
                                        h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                           h(aenc(~kgs, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                               ) @ #vk.71 )
                          case c_mac
                          solve( !KU( kdf(~kgs) ) @ #vk.77 )
                            case c_kdf
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case Reveal_Kgs
                        by contradiction /* from formulas */
                      next
                        case SAT_6
                        solve( !KU( mac(kdf(~kgs),
                                        h(<$U.1, $S.1, $G.1, h(aenc(~kgs, pk(~ltkK.3))), h(epkU), muU.1, T1.1
                                          >))
                               ) @ #vk.68 )
                          case c_mac
                          solve( !KU( kdf(~kgs) ) @ #vk.74 )
                            case c_kdf
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case c_sign
        solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
          case Enroll_UE
          solve( !PkKemU( $U, pkKU ) ▶₇ #i )
            case Enroll_UE
            solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
              case Enroll_SAT
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_sign
      solve( !KU( sign(h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, 
                          h(aenc(sssg, pk(ltkKG))), h(epkS), h(esu), muS, T2>),
                       x.1)
             ) @ #vk.27 )
        case SAT_2
        solve( !KU( mac(kdf(ssus),
                        h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
               ) @ #vk.40 )
          case UE_1
          solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                              ~muU, ~T1>),
                           ~ltkS.1)
                 ) @ #vk.40 )
            case UE_1
            by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
          next
            case c_sign
            by contradiction /* from formulas */
          qed
        next
          case c_mac
          solve( !KU( kdf(ssus) ) @ #vk.41 )
            case c_kdf
            solve( !KU( sign(h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, 
                                T1>),
                             ~ltkS.1)
                   ) @ #vk.41 )
              case UE_1
              by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
            next
              case c_sign
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case c_sign
        solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
          case Enroll_UE
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
qed

lemma gs_secret_kgu [reuse, heuristic={macfirst}]:
  all-traces
  "∀ G U S kgs kgu #i #j.
    ((GSKeys( G, U, S, kgs, kgu ) @ #i) ∧ (!KU( kgu ) @ #j)) ⇒
    (((((∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i)) ∨
        (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ #r. RevKgs( kgs ) @ #r)) ∨
     (∃ #r. RevKgu( kgu ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ G U S kgs kgu #i #j.
  (GSKeys( G, U, S, kgs, kgu ) @ #i) ∧ (!KU( kgu ) @ #j)
 ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKgs( kgs ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKgu( kgu ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !KU( mac(kdf(sssg),
                h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                   h(epkS), h(esu), muS, T2>))
       ) @ #vk.26 )
  case SAT_2
  solve( !KU( mac(kdf(ssus),
                  h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
         ) @ #vk.35 )
    case UE_1
    solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                        ~muU, ~T1>),
                     x)
           ) @ #vk.19 )
      case UE_1
      solve( !KU( sign(h(<
                          <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                          h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                          ~muS, ~T2>),
                       x)
             ) @ #vk.33 )
        case SAT_2
        solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
          case Enroll_UE
          solve( !PkKemU( $U, pkKU ) ▶₇ #i )
            case Enroll_UE
            solve( !PkSigS( $S, pk(~ltkS.1) ) ▶₈ #i )
              case Enroll_SAT
              solve( !LtkKemG( $G, ~ltkK.1 ) ▶₉ #i )
                case Enroll_GS
                solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                  case Enroll_GS
                  solve( !KU( ~kgu ) @ #j )
                    case GS_3
                    solve( !KU( ~eskU ) @ #vk.35 )
                      case Reveal_Eph
                      by contradiction /* from formulas */
                    qed
                  next
                    case GS_7_case_1
                    solve( !KU( mac(kdf(~kgu),
                                    h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                       h(aenc(~kgu, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                           ) @ #vk.65 )
                      case c_mac
                      solve( !KU( kdf(~kgu) ) @ #vk.71 )
                        case c_kdf
                        by contradiction /* cyclic */
                      qed
                    qed
                  next
                    case GS_7_case_2
                    solve( (∃ #r. (RevSig( $U ) @ #r) ∧ #r < #i)  ∥
                           (∃ #r. (RevSig( $S ) @ #r) ∧ #r < #i)  ∥ (∃ e #r. (RevEph( e ) @ #r))  ∥
                           (∃ #r. (RevKgs( ~kgs ) @ #r))  ∥ (∃ #r. (RevKgu( ~kgu ) @ #r)) )
                      case case_1
                      by contradiction /* from formulas */
                    next
                      case case_2
                      by contradiction /* from formulas */
                    next
                      case case_3
                      by contradiction /* from formulas */
                    next
                      case case_4
                      by contradiction /* from formulas */
                    next
                      case case_5
                      by contradiction /* from formulas */
                    qed
                  next
                    case Reveal_Kgu
                    by contradiction /* from formulas */
                  next
                    case SAT_6
                    solve( !KU( mac(kdf(~kgu),
                                    h(<$U.1, $S.1, $G.1, h(aenc(~kgu, pk(~ltkK.3))), h(epkU), muU.1, T1.1>))
                           ) @ #vk.62 )
                      case c_mac
                      solve( !KU( kdf(~kgu) ) @ #vk.68 )
                        case c_kdf
                        by contradiction /* cyclic */
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case c_sign
        solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
          case Enroll_UE
          solve( !PkKemU( $U, pkKU ) ▶₇ #i )
            case Enroll_UE
            solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
              case Enroll_SAT
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case c_sign
      solve( !KU( sign(h(<
                          <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                          h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                          ~muS, ~T2>),
                       x.1)
             ) @ #vk.33 )
        case SAT_2
        solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                            ~muU, ~T1>),
                         ~ltkS.1)
               ) @ #vk.35 )
          case UE_1
          by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
        next
          case c_sign
          by contradiction /* from formulas */
        qed
      next
        case c_sign
        solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                            ~muU, ~T1>),
                         ~ltkS)
               ) @ #vk.35 )
          case UE_1
          by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
        next
          case c_sign
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case c_mac
    solve( !KU( kdf(ssus) ) @ #vk.36 )
      case c_kdf
      solve( !KU( sign(h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, 
                          T1>),
                       x)
             ) @ #vk.22 )
        case UE_1
        solve( !KU( sign(h(<
                            <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                            h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                            ~muS, ~T2>),
                         x)
               ) @ #vk.34 )
          case SAT_2
          solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
            case Enroll_UE
            solve( !PkKemU( $U, pkKU ) ▶₇ #i )
              case Enroll_UE
              solve( !PkSigS( $S, pk(~ltkS.1) ) ▶₈ #i )
                case Enroll_SAT
                solve( !LtkKemG( $G, ~ltkK.1 ) ▶₉ #i )
                  case Enroll_GS
                  solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                    case Enroll_GS
                    solve( !KU( ~kgu ) @ #j )
                      case GS_3
                      solve( !KU( ~eskU ) @ #vk.38 )
                        case Reveal_Eph
                        by contradiction /* from formulas */
                      qed
                    next
                      case GS_7_case_1
                      solve( !KU( mac(kdf(~kgu),
                                      h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                         h(aenc(~kgu, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                             ) @ #vk.68 )
                        case c_mac
                        solve( !KU( kdf(~kgu) ) @ #vk.74 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case GS_7_case_2
                      solve( (∃ #r. (RevSig( $U ) @ #r) ∧ #r < #i)  ∥
                             (∃ #r. (RevSig( $S ) @ #r) ∧ #r < #i)  ∥ (∃ e #r. (RevEph( e ) @ #r))  ∥
                             (∃ #r. (RevKgs( ~kgs ) @ #r))  ∥ (∃ #r. (RevKgu( ~kgu ) @ #r)) )
                        case case_1
                        by contradiction /* from formulas */
                      next
                        case case_2
                        by contradiction /* from formulas */
                      next
                        case case_3
                        by contradiction /* from formulas */
                      next
                        case case_4
                        by contradiction /* from formulas */
                      next
                        case case_5
                        by contradiction /* from formulas */
                      qed
                    next
                      case Reveal_Kgu
                      by contradiction /* from formulas */
                    next
                      case SAT_6
                      solve( !KU( mac(kdf(~kgu),
                                      h(<$U.1, $S.1, $G.1, h(aenc(~kgu, pk(~ltkK.3))), h(epkU), muU.1, T1.1>))
                             ) @ #vk.65 )
                        case c_mac
                        solve( !KU( kdf(~kgu) ) @ #vk.71 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case c_sign
          solve( !PkSigU( $U, pk(~ltkS) ) ▶₆ #i )
            case Enroll_UE
            solve( !PkKemU( $U, pkKU ) ▶₇ #i )
              case Enroll_UE
              solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
                case Enroll_SAT
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case c_sign
        solve( !KU( sign(h(<
                            <$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                            h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                           >),
                         x.1)
               ) @ #vk.34 )
          case SAT_2
          solve( !KU( sign(h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, 
                              T1>),
                           ~ltkS.1)
                 ) @ #vk.36 )
            case UE_1
            by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
          next
            case c_sign
            by contradiction /* from formulas */
          qed
        next
          case c_sign
          solve( !KU( sign(h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, 
                              T1>),
                           ~ltkS)
                 ) @ #vk.36 )
            case UE_1
            by solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
          next
            case c_sign
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
next
  case c_mac
  solve( !KU( kdf(sssg) ) @ #vk.27 )
    case c_kdf
    solve( !KU( sign(h(<$U, $S, $G, hcus, h(epkU), muU, T1>), x) ) @ #vk.14 )
