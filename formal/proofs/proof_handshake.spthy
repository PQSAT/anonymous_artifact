lemma agree_kem_sat_ue [heuristic={kemmode}, hide_lemma=gs_secret_kgs,
                        hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'SAT', 'UE', U, S, G, sk ) @ #i) ⇒
    ((((∃ #j.
         ((Running( 'UE', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
         (¬(∃ U2 S2 G2 #i2.
             (Commit( 'SAT', 'UE', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
       (∃ #r. RevKem( U ) @ #r)) ∨
      (∃ #r. RevKem( S ) @ #r)) ∨
     (∃ #r. RevKem( G ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'SAT', 'UE', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'UE', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'SAT', 'UE', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'SAT', 'UE', U, S, G, sk ) @ #i )
  case SAT_8
  solve( SAT_St7( $S, $U, $G, sk, muU, muS, muG ) ▶₁ #i )
    case SAT_7
    solve( !KU( mac(kdf(ssgu),
                    h(<
                       <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                       >, 
                       $G, h(cgu), h(aenc(kgs, pk(~eskS))), h(egu), muG, T3>))
           ) @ #vk.17 )
      case GS_3
      solve( !KU( mac(kdf(ssus),
                      h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.35 )
        case UE_1
        solve( !KU( mac(kdf(~sssg),
                        h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                           h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                           ~muS, ~T2>))
               ) @ #vk.52 )
          case SAT_2
          solve( !KU( h(<
                         kdf(<~ksu, ~kgs, kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, $G, 
                              <
                               <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                ~muS, ~T2>, 
                               $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                               h(aenc(~kgu.1, pk(~eskU))), ~muG, ~T3>, 
                              'SK'>), 
                         ~muU, ~muS, ~muG, 'UE-fin-final'>)
                 ) @ #vk.6 )
            case UE_8
            solve( (#i2 < #i)  ∥ (#i < #i2) )
              case case_1
              solve( Commit( 'SAT', 'UE', U2, S2, G2,
                             kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                  $G, 
                                  <
                                   <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                    h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                    ~muS, ~T2>, 
                                   $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                   h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                  'SK'>)
                     ) @ #i2 )
                case SAT_8
                solve( SAT_St7( $S.1, $U.1, $G.1,
                                kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                     $G, 
                                     <
                                      <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                       h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                       ~muS, ~T2>, 
                                      $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                      h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                     'SK'>),
                                muU.1, muS.1, muG.1
                       ) ▶₁ #i2 )
                  case SAT_7
                  by contradiction /* cyclic */
                qed
              qed
            next
              case case_2
              solve( Commit( 'SAT', 'UE', U2, S2, G2,
                             kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                  $G, 
                                  <
                                   <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                    h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                    ~muS, ~T2>, 
                                   $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                   h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                  'SK'>)
                     ) @ #i2 )
                case SAT_8
                solve( SAT_St7( $S.1, $U.1, $G.1,
                                kdf(<~ksu, ~kgs, ~kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, 
                                     $G, 
                                     <
                                      <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                       h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                       ~muS, ~T2>, 
                                      $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                      h(aenc(~kgu, pk(~eskU))), ~muG, ~T3>, 
                                     'SK'>),
                                muU.1, muS.1, muG.1
                       ) ▶₁ #i2 )
                  case SAT_7
                  by contradiction /* cyclic */
                qed
              qed
            qed
          next
            case c_h
            solve( !KU( kdf(<~ksu, ~kgs, kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, 
                             $U, $S, $G, 
                             <
                              <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                               h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                               ~muS, ~T2>, 
                              $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                              h(aenc(~kgu.1, pk(~eskU))), ~muG, ~T3>, 
                             'SK'>)
                   ) @ #vk.57 )
              case c_kdf
              solve( (∃ #r. (RevKem( $U ) @ #r))  ∥ (∃ #r. (RevKem( $S ) @ #r))  ∥
                     (∃ #r. (RevKem( $G ) @ #r)) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
                by contradiction /* from formulas */
              next
                case case_3
                by contradiction /* from formulas */
              qed
            qed
          qed
        next
          case c_mac
          solve( !KU( kdf(~sssg) ) @ #vk.53 )
            case c_kdf
            solve( (∃ #r. (RevKem( $U ) @ #r))  ∥ (∃ #r. (RevKem( $S ) @ #r))  ∥
                   (∃ #r. (RevKem( $G ) @ #r)) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              by contradiction /* from formulas */
            next
              case case_3
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case c_mac
        solve( !KU( kdf(ssus) ) @ #vk.53 )
          case c_kdf
          solve( !KU( mac(kdf(~sssg),
                          h(<<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                             h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                            >))
                 ) @ #vk.53 )
            case SAT_2
            solve( !KU( h(<
                           kdf(<~ksu, ~kgs, kgu, ssus, ~sssg, ~ssgu, muU, ~muS, ~muG, $U, $S, $G, 
                                <
                                 <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                                 >, 
                                 $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                 h(aenc(~kgu.1, epkU)), ~muG, ~T3>, 
                                'SK'>), 
                           muU, ~muS, ~muG, 'UE-fin-final'>)
                   ) @ #vk.9 )
              case UE_8
              solve( (∃ #r. (RevKem( $U ) @ #r))  ∥ (∃ #r. (RevKem( $S ) @ #r))  ∥
                     (∃ #r. (RevKem( $G ) @ #r)) )
                case case_1
                by contradiction /* from formulas */
              next
                case case_2
