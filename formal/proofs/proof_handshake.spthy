     (∃ U2 S2 G2 #i2.
       (Commit( 'UE', 'GS', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
