                                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, 
                                        ~T2>, 
                                       $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                                       h(aenc(~kgu, epkU)), ~muG, ~T3>, 
                                      'SK'>)
                         ) @ #i2 )
                    case SAT_7
                    solve( SAT_St6( $S, $U, $G, ~ksu, ~kgs, ssus, ~sssg, muU, ~muS, ~muG,
                                    <
                                     <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                                      h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, 
                                      ~T2>, 
