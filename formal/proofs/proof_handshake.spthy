lemma secrecy_kem [heuristic={kemmode}, hide_lemma=gs_secret_kgs,
                   hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ R U S G sk #i.
    ((((SKey( R, U, S, G, sk ) @ #i) ∧ (¬(∃ #r. RevKem( U ) @ #r))) ∧
      (¬(∃ #r. RevKem( S ) @ #r))) ∧
     (¬(∃ #r. RevKem( G ) @ #r))) ⇒
    (¬(∃ #j. K( sk ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ R U S G sk #i.
  (SKey( R, U, S, G, sk ) @ #i)
 ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥) ∧
  (∃ #j. (K( sk ) @ #j))"
*/
simplify
solve( SKey( R, U, S, G, sk ) @ #i )
  case GS_7
  solve( !KU( kdf(<ksu, kgs, kgu, ssus, sssg, ssgu, muU, muS, muG, $U, $S, 
                   $G, Pi3, 'SK'>)
         ) @ #vk )
    case c_kdf
