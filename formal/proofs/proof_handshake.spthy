lemma agree_kem_gs_ue [heuristic={kemmode}, hide_lemma=gs_secret_kgs,
                       hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'GS', 'UE', U, S, G, sk ) @ #i) ⇒
    ((((∃ #j.
         ((Running( 'UE', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
         (¬(∃ U2 S2 G2 #i2.
             (Commit( 'GS', 'UE', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
       (∃ #r. RevKem( U ) @ #r)) ∨
      (∃ #r. RevKem( S ) @ #r)) ∨
     (∃ #r. RevKem( G ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'GS', 'UE', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'UE', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'GS', 'UE', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'GS', 'UE', U, S, G, sk ) @ #i )
  case GS_8
  solve( GS_St7( $G, $U, $S, sk, muU, muS, muG ) ▶₁ #i )
    case GS_7
    solve( !KU( mac(kdf(sssg),
                    h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(~ltkK))), 
                       h(epkS), h(esu), muS, T2>))
           ) @ #vk.32 )
      case SAT_2
      solve( !KU( mac(kdf(ssus.1),
                      h(<$U, $S, $G, h(aenc(ssus.1, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.40 )
        case UE_1
        solve( !KU( h(<
                       kdf(<ksu, ~kgs, ~kgu, ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, $G, 
                            <
                             <<$U, $S, $G, h(aenc(~ssus.1, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                              h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu.1, pk(~eskU))), 
                              ~muS, ~T2>, 
                             $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
