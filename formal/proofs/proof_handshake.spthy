qed

lemma auth_secret [reuse, use_induction, heuristic={kemmode},
                   hide_lemma=gs_secret_kgs, hide_lemma=gs_secret_kgu]:
  all-traces
  "∀ U S G x #i #j.
    ((AuthSecret( U, S, G, x ) @ #i) ∧ (!KU( x ) @ #j)) ⇒
    (((∃ #r. RevKem( U ) @ #r) ∨ (∃ #r. RevKem( S ) @ #r)) ∨
     (∃ #r. RevKem( G ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G x #i #j.
  (AuthSecret( U, S, G, x ) @ #i) ∧ (!KU( x ) @ #j)
 ∧
  (∀ #r. (RevKem( U ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevKem( G ) @ #r) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#j))  ∥ (last(#i))  ∥
         (∃ #r. (RevKem( U ) @ #r) ∧ ¬(last(#r)))  ∥
         (∃ #r. (RevKem( S ) @ #r) ∧ ¬(last(#r)))  ∥
         (∃ #r. (RevKem( G ) @ #r) ∧ ¬(last(#r))) )
    case case_1
    solve( AuthSecret( U, S, G, x ) @ #i )
      case GS_3
      solve( !KU( mac(kdf(sssg),
                      h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, h(aenc(sssg, pk(ltkKG))), 
                         h(epkS), h(esu), muS, T2>))
             ) @ #vk.26 )
        case SAT_2
        solve( !KU( mac(kdf(ssus),
                        h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
               ) @ #vk.35 )
          case UE_1
          solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
            case Enroll_UE
            solve( !PkKemU( $U, pkKU ) ▶₇ #i )
              case Enroll_UE
              solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
                case Enroll_SAT
                solve( !LtkKemG( $G, ~ltkK.1 ) ▶₉ #i )
                  case Enroll_GS
                  solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                    case Enroll_GS
                    solve( !KU( ~ssgu ) @ #j )
                      case GS_3
                      by contradiction /* from formulas */
                    next
                      case GS_7_case_1
                      solve( !KU( mac(kdf(~ssgu),
                                      h(<<$U.1, $S.1, $G.1, hcus, h(epkU), muU.1, T1.1>, $S.1, 
                                         h(aenc(~ssgu, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                             ) @ #vk.65 )
                        case c_mac
                        solve( !KU( kdf(~ssgu) ) @ #vk.71 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case GS_7_case_2
                      solve( (∃ #r. (RevKem( $U ) @ #r) ∧ ¬(last(#r)))  ∥
                             (∃ #r. (RevKem( $S ) @ #r) ∧ ¬(last(#r)))  ∥
                             (∃ #r. (RevKem( $G ) @ #r) ∧ ¬(last(#r))) )
                        case case_1
                        by contradiction /* from formulas */
                      next
                        case case_2
                        by contradiction /* from formulas */
                      next
                        case case_3
                        by contradiction /* from formulas */
                      qed
                    next
                      case SAT_6
                      solve( !KU( mac(kdf(~ssgu),
                                      h(<$U.1, $S.1, $G.1, h(aenc(~ssgu, pk(~ltkK.3))), h(epkU), muU.1, T1.1
                                        >))
                             ) @ #vk.62 )
                        case c_mac
                        solve( !KU( kdf(~ssgu) ) @ #vk.68 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case c_mac
          solve( !KU( kdf(ssus) ) @ #vk.36 )
            case c_kdf
            solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
              case Enroll_UE
              solve( !PkKemU( $U, pkKU ) ▶₇ #i )
                case Enroll_UE
                solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
                  case Enroll_SAT
                  solve( !LtkKemG( $G, ~ltkK.1 ) ▶₉ #i )
                    case Enroll_GS
                    solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                      case Enroll_GS
                      solve( !KU( ~ssgu ) @ #j )
                        case GS_3
                        by contradiction /* from formulas */
                      next
                        case GS_7_case_1
                        solve( !KU( mac(kdf(~ssgu),
                                        h(<<$U.1, $S.1, $G.1, hcus, h(epkU.1), muU.1, T1.1>, $S.1, 
                                           h(aenc(~ssgu, pk(~ltkK.3))), h(epkS), h(esu), muS.1, T2.1>))
                               ) @ #vk.68 )
                          case c_mac
                          solve( !KU( kdf(~ssgu) ) @ #vk.74 )
                            case c_kdf
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case GS_7_case_2
                        solve( (∃ #r. (RevKem( $U ) @ #r) ∧ ¬(last(#r)))  ∥
                               (∃ #r. (RevKem( $S ) @ #r) ∧ ¬(last(#r)))  ∥
                               (∃ #r. (RevKem( $G ) @ #r) ∧ ¬(last(#r))) )
                          case case_1
                          by contradiction /* from formulas */
                        next
                          case case_2
                          by contradiction /* from formulas */
                        next
                          case case_3
                          by contradiction /* from formulas */
                        qed
                      next
                        case SAT_6
                        solve( !KU( mac(kdf(~ssgu),
                                        h(<$U.1, $S.1, $G.1, h(aenc(~ssgu, pk(~ltkK.3))), h(epkU.1), muU.1, 
                                           T1.1>))
                               ) @ #vk.65 )
                          case c_mac
                          solve( !KU( kdf(~ssgu) ) @ #vk.71 )
                            case c_kdf
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case c_mac
        solve( !KU( kdf(sssg) ) @ #vk.27 )
          case c_kdf
          solve( !PkSigU( $U, pk(x) ) ▶₆ #i )
            case Enroll_UE
            solve( !PkKemU( $U, pkKU ) ▶₇ #i )
              case Enroll_UE
              solve( !PkSigS( $S, pk(x) ) ▶₈ #i )
                case Enroll_SAT
                solve( !LtkKemG( $G, ltkKG ) ▶₉ #i )
                  case Enroll_GS
                  solve( !LtkSigG( $G, ltkSG ) ▶₁₀ #i )
                    case Enroll_GS
                    solve( !KU( ~ssgu ) @ #j )
                      case GS_3
                      by contradiction /* from formulas */
                    next
                      case GS_7_case_1
                      solve( !KU( mac(kdf(~ssgu),
                                      h(<<$U.1, $S.1, $G.1, hcus.1, h(epkU.1), muU.1, T1.1>, $S.1, 
                                         h(aenc(~ssgu, pk(~ltkK.3))), h(epkS.1), h(esu.1), muS.1, T2.1>))
                             ) @ #vk.60 )
                        case c_mac
                        solve( !KU( kdf(~ssgu) ) @ #vk.66 )
                          case c_kdf
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case GS_7_case_2
                      solve( !KU( ~kgs ) @ #vk.36 )
                        case GS_3
                        solve( !KU( aenc(sssg, pk(~ltkK)) ) @ #vk.24 )
                          case GS_3_case_1
                          solve( !KU( mac(kdf(sssg),
                                          h(<<$U.1, $S.1, $G.1, hcus.1, h(epkU.1), muU.1, T1.1>, $S.1, 
                                             h(aenc(sssg, pk(~ltkK.3))), h(pk(~ltkK)), h(esu.1), muS.1, T2.1
                                            >))
                                 ) @ #vk.65 )
                            case c_mac
                            solve( !KU( kdf(sssg) ) @ #vk.66 )
                              case c_kdf
                              solve( !KU( ~kgs ) @ #vk.35 )
                                case GS_3
                                by contradiction /* from formulas */
                              next
                                case GS_7_case_1
                                solve( (∃ #r. (RevKem( $U.1 ) @ #r) ∧ ¬(last(#r)))  ∥
                                       (∃ #r. (RevKem( $S.1 ) @ #r) ∧ ¬(last(#r)))  ∥
                                       (∃ #r. (RevKem( $G.1 ) @ #r) ∧ ¬(last(#r))) )
                                  case case_1
                                  solve( RevKem( $U.1 ) @ #r )
                                    case Reveal_Kem_GS
                                    by solve( !LtkKemG( $U.1, ltkK.2 ) ▶₀ #r )
                                  next
                                    case Reveal_Kem_SAT
                                    by solve( !LtkKemS( $U.1, ltkK.2 ) ▶₀ #r )
                                  next
                                    case Reveal_Kem_UE
                                    solve( !LtkKemU( $U.1, ltkK.2 ) ▶₀ #r )
                                      case Enroll_UE
                                      solve( !KU( ~kgu.1 ) @ #vk.74 )
                                        case GS_3
                                        solve( !KU( ~ssgu.1 ) @ #vk.76 )
                                          case GS_3
                                          solve( !KU( ~ltkK.2 ) @ #vk.79 )
                                            case Reveal_Kem_UE
                                            solve( RevKem( $U.1 ) @ #r.1 )
                                              case Reveal_Kem_GS
                                              by solve( !LtkKemG( $U.1, ltkK.3 ) ▶₀ #r.1 )
                                            next
                                              case Reveal_Kem_SAT
                                              by solve( !LtkKemS( $U.1, ltkK.3 ) ▶₀ #r.1 )
                                            next
                                              case Reveal_Kem_UE
                                              solve( !LtkKemU( $U.1, ltkK.3 ) ▶₀ #r.1 )
                                                case Enroll_UE
                                                solve( RevKem( $U.1 ) @ #r.2 )
                                                  case Reveal_Kem_GS
                                                  by solve( !LtkKemG( $U.1, ltkK.4 ) ▶₀ #r.2 )
                                                next
                                                  case Reveal_Kem_SAT
                                                  by solve( !LtkKemS( $U.1, ltkK.4 ) ▶₀ #r.2 )
                                                next
                                                  case Reveal_Kem_UE
                                                  solve( !LtkKemU( $U.1, ltkK.4 ) ▶₀ #r.2 )
                                                    case Enroll_UE
                                                    solve( !KU( h(<<$U, $S, $G, hcus, h(epkU), muU, T1>, $S, 
                                                                   h(aenc(~kgs, pk(~ltkK))), h(pk(x)), 
                                                                   h(esu), muS, T2>)
                                                           ) @ #vk.53 )
                                                      case c_h
                                                      solve( !KU( senc(<'wrap-su-g', ksu, ssus>,
                                                                       kdf(<~kgs.1, ~kgs, 'wrap-sg'>))
                                                             ) @ #vk.62 )
                                                        case c_senc
                                                        solve( !KU( h(<ksu, ~kgu, ssus, ~ssgu, muU, muS, 
                                                                       ~muG, 'UE-fin'>)
                                                               ) @ #vk.67 )
                                                          case UE_5
                                                          solve( !KU( mac(kdf(~ssgu),
                                                                          h(<
                                                                             <
                                                                              <$U.2, $S.2, $G.2, 
                                                                               h(aenc(~ssus, pk(~ltkK.6))), 
                                                                               h(pk(~eskU)), ~muU, ~T1.2>, 
                                                                              $S.2, hcsg, hepkS, 
                                                                              h(aenc(ksu, pk(~eskU))), muS, 
                                                                              T2.2>, 
                                                                             $G.2, 
                                                                             h(aenc(~ssgu, pk(~ltkK.7))), 
                                                                             hegs, h(aenc(~kgu, pk(~eskU))), 
                                                                             ~muG, T3.2>))
                                                                 ) @ #vk.127 )
                                                            case GS_3
                                                            solve( (∃ #r.
                                                                     (RevKem( $U ) @ #r) ∧ ¬(last(#r)))  ∥
                                                                   (∃ #r.
                                                                     (RevKem( $S ) @ #r) ∧ ¬(last(#r)))  ∥
                                                                   (∃ #r. (RevKem( $G ) @ #r) ∧ ¬(last(#r))) )
                                                              case case_1
                                                              by contradiction /* from formulas */
                                                            next
                                                              case case_2
                                                              by contradiction /* from formulas */
                                                            next
                                                              case case_3
                                                              by contradiction /* from formulas */
                                                            qed
                                                          next
                                                            case c_mac
                                                            solve( !KU( kdf(~ssgu) ) @ #vk.128 )
                                                              case c_kdf
                                                              by contradiction /* cyclic */
                                                            qed
                                                          qed
                                                        next
                                                          case c_h
                                                          by contradiction /* cyclic */
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        next
                                          case GS_7_case_1
                                          solve( !KU( mac(kdf(~ssgu.1),
                                                          h(<
                                                             <$U.2, $S.2, $G.2, hcus.2, h(epkU.1), muU.2, T1.2
                                                             >, 
                                                             $S.2, h(aenc(~ssgu.1, pk(~ltkK.6))), h(epkS), 
                                                             h(esu.2), muS.2, T2.2>))
                                                 ) @ #vk.110 )
                                            case c_mac
                                            solve( !KU( kdf(~ssgu.1) ) @ #vk.114 )
                                              case c_kdf
                                              by contradiction /* cyclic */
                                            qed
                                          qed
                                        next
                                          case GS_7_case_2
                                          by contradiction /* cyclic */
                                        next
                                          case SAT_6
                                          solve( !KU( mac(kdf(~ssgu.1),
                                                          h(<$U.2, $S.2, $G.2, h(aenc(~ssgu.1, pk(~ltkK.6))), 
                                                             h(epkU.1), muU.2, T1.2>))
                                                 ) @ #vk.107 )
                                            case c_mac
                                            solve( !KU( kdf(~ssgu.1) ) @ #vk.111 )
                                              case c_kdf
