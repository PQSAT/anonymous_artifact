                                        by solve( !LtkKemU( $S, ltkK.3 ) ▶₀ #r.2 )
                                      qed
                                    qed
                                  qed
                                qed
                              next
                                case Reveal_Kem_SAT
                                by solve( !LtkKemS( $G, ltkK.3 ) ▶₀ #r.1 )
                              next
                                case Reveal_Kem_UE
                                by solve( !LtkKemU( $G, ltkK.3 ) ▶₀ #r.1 )
                              qed
                            qed
                          next
                            case Reveal_Kem_SAT
                            by solve( !LtkKemS( $G, ltkK.3 ) ▶₀ #r )
                          next
                            case Reveal_Kem_UE
                            by solve( !LtkKemU( $G, ltkK.3 ) ▶₀ #r )
                          qed
                        qed
                      next
                        case SAT_6
                        solve( !KU( mac(kdf(~sssg),
                                        h(<$U.1, $S.1, $G.1, h(aenc(~sssg, pk(~ltkK.3))), h(epkU), muU.1, T1.1
                                          >))
                               ) @ #vk.88 )
                          case c_mac
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case c_sign
                      by contradiction /* from formulas */
                    qed
                  next
                    case c_sign
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            next
              case c_sign
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma agree_dsa_sat_ue [heuristic={macfirst}, hide_lemma=auth_secret]:
  all-traces
  "∀ U S G sk #i.
    (Commit( 'SAT', 'UE', U, S, G, sk ) @ #i) ⇒
    (((((((∃ #j.
            ((Running( 'UE', U, S, G, sk ) @ #j) ∧ (#j < #i)) ∧
            (¬(∃ U2 S2 G2 #i2.
                (Commit( 'SAT', 'UE', U2, S2, G2, sk ) @ #i2) ∧ (¬(#i2 = #i))))) ∨
          (∃ #r. (RevSig( U ) @ #r) ∧ (#r < #i))) ∨
         (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
        (∃ #r. (RevSig( G ) @ #r) ∧ (#r < #i))) ∨
       (∃ e #r. RevEph( e ) @ #r)) ∨
      (∃ e #r. RevKgs( e ) @ #r)) ∨
     (∃ e #r. RevKgu( e ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i.
  (Commit( 'SAT', 'UE', U, S, G, sk ) @ #i)
 ∧
  (∀ #j.
    (Running( 'UE', U, S, G, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨
     (∃ U2 S2 G2 #i2.
       (Commit( 'SAT', 'UE', U2, S2, G2, sk ) @ #i2) ∧ ¬(#i2 = #i)))) ∧
  (∀ #r. (RevSig( U ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevSig( G ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ e #r. (RevEph( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgs( e ) @ #r) ⇒ ⊥) ∧
  (∀ e #r. (RevKgu( e ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Commit( 'SAT', 'UE', U, S, G, sk ) @ #i )
  case SAT_8
  solve( SAT_St7( $S, $U, $G, sk, muU, muS, muG ) ▶₁ #i )
    case SAT_7
    solve( !KU( mac(kdf(ssgu),
                    h(<
                       <<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>, $S, 
                        h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, epkU)), ~muS, ~T2
                       >, 
                       $G, h(cgu), h(aenc(kgs, pk(~eskS))), h(egu), muG, T3>))
           ) @ #vk.17 )
      case GS_3
      solve( !KU( mac(kdf(ssus),
                      h(<$U, $S, $G, h(aenc(ssus, pk(~ltkK))), h(epkU), muU, T1>))
             ) @ #vk.35 )
        case UE_1
        solve( !KU( mac(kdf(~sssg),
                        h(<<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                           h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                           ~muS, ~T2>))
               ) @ #vk.52 )
          case SAT_2
          solve( !KU( sign(h(<
                              <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                               h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                               ~muS, ~T2>, 
                              $G, h(aenc(~ssgu, pk(~ltkK.2))), h(aenc(~kgs, pk(~eskS))), 
                              h(aenc(~kgu.1, pk(~eskU))), ~muG, ~T3>),
                           ~ltkS)
                 ) @ #vk.20 )
            case GS_3
            solve( !KU( sign(h(<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), 
                                ~muU, ~T1>),
                             ~ltkS.1)
                   ) @ #vk.37 )
              case UE_1
              solve( !KU( sign(h(<
                                  <$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                  h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
                                  ~muS, ~T2>),
                               ~ltkS.2)
                     ) @ #vk.52 )
                case SAT_2
                solve( !KU( h(<
                               kdf(<~ksu, ~kgs, kgu, ~ssus, ~sssg, ~ssgu, ~muU, ~muS, ~muG, $U, $S, $G, 
                                    <
                                     <<$U, $S, $G, h(aenc(~ssus, pk(~ltkK))), h(pk(~eskU)), ~muU, ~T1>, $S, 
                                      h(aenc(~sssg, pk(~ltkK.1))), h(pk(~eskS)), h(aenc(~ksu, pk(~eskU))), 
