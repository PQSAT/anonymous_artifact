  "∀ Fd S kgl #i.
    (GlinkAccepted( Fd, S, kgl ) @ #i) ⇒
    ((∃ #j. (GlinkSent( S, Fd, kgl ) @ #j) ∧ (#j < #i)) ∨
     (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i)))"
