lemma R2_leaked_satellite_signing_key:
  exists-trace
  "∃ Sn S U skn #i #j.
    ((((HandoverAccepted( Sn, S, U, skn ) @ #i) ∧ (K( skn ) @ #j)) ∧
      (¬(∃ A k #r. CompromisedSat( A, k ) @ #r))) ∧
     (¬(∃ A #r. RevKem( A ) @ #r))) ∧
    (¬(∃ G2 U2 S2 Sx sk2 #r. HandoverOrdered( G2, U2, S2, Sx, sk2 ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ Sn S U skn #i #j.
  (HandoverAccepted( Sn, S, U, skn ) @ #i) ∧ (K( skn ) @ #j)
 ∧
  (∀ A k #r. (CompromisedSat( A, k ) @ #r) ⇒ ⊥) ∧
  (∀ A #r. (RevKem( A ) @ #r) ⇒ ⊥) ∧
  (∀ G2 U2 S2 Sx sk2 #r.
    (HandoverOrdered( G2, U2, S2, Sx, sk2 ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !SatKem( $Sn, ltkK ) ▶₁ #i )
  case Enroll_SAT
  solve( !SatPkSig( $S, pk(x) ) ▶₂ #i )
    case Enroll_SAT
    solve( !KU( sign(<'USERSESS', $S, $Sn, aenc(ss, pk(~ltkK)), 
                      senc(<'USERSESS', $U, $S, $Sn, skn>, kdf(ss))>,
                     ~ltkS)
           ) @ #vk.4 )
      case c_sign
      solve( !SatSig( $S, ltkS.2 ) ▶₀ #r )
        case Enroll_SAT
