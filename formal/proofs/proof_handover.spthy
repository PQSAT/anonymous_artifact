          case c_kdf
          solve( !KU( ~sk ) @ #vk.15 )
            case Compromise_Serving
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case c_sign
      by contradiction /* from formulas */
    qed
  qed
qed

