solve( !KU( ~ltkK ) @ #j )
  case Reveal_Kem
  by contradiction /* from formulas */
qed

lemma executable:
  exists-trace
  "∃ U S G Fd Sn sk kgl skn #a #b #g #c #d #e.
    (((((((((((Established( U, S, G, sk ) @ #a) ∧
              (GlinkAccepted( Fd, S, kgl ) @ #b)) ∧
             (GlinkOf( kgl, sk ) @ #g)) ∧
            (HandoverOrdered( G, U, S, Sn, sk ) @ #c)) ∧
           (HandoverAccepted( Sn, S, U, skn ) @ #d)) ∧
          (UEHandover( U, Sn, skn ) @ #e)) ∧
         (¬(S = Fd))) ∧
        (¬(S = Sn))) ∧
       (¬(Fd = Sn))) ∧
      (¬(∃ A #r. RevSig( A ) @ #r))) ∧
     (¬(∃ A #r. RevKem( A ) @ #r))) ∧
    (¬(∃ A k #r. CompromisedSat( A, k ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ U S G Fd Sn sk kgl skn #a #b #g #c #d #e.
  (Established( U, S, G, sk ) @ #a) ∧
  (GlinkAccepted( Fd, S, kgl ) @ #b) ∧
  (GlinkOf( kgl, sk ) @ #g) ∧
  (HandoverOrdered( G, U, S, Sn, sk ) @ #c) ∧
  (HandoverAccepted( Sn, S, U, skn ) @ #d) ∧
  (UEHandover( U, Sn, skn ) @ #e)
 ∧
  (¬(S = Fd)) ∧
  (¬(S = Sn)) ∧
  (¬(Fd = Sn)) ∧
  (∀ A #r. (RevSig( A ) @ #r) ⇒ ⊥) ∧
  (∀ A #r. (RevKem( A ) @ #r) ⇒ ⊥) ∧
  (∀ A k #r. (CompromisedSat( A, k ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !SatSig( $S, ltkS ) ▶₁ #a )
  case Enroll_SAT
  solve( !SatKem( $F, ltkK ) ▶₁ #b )
    case Enroll_SAT
    solve( !SatPkSig( $S, pk(x) ) ▶₂ #b )
      case Enroll_SAT
      solve( !Serving( $S.1, $U.1, $G.1, ~sk ) ▶₀ #g )
        case Established
        solve( !SatSig( $S, ltkS.1 ) ▶₂ #g )
          case Enroll_SAT
          solve( !SatPkKem( $F.1, pkF ) ▶₃ #g )
            case Enroll_SAT
            solve( !GSHolds( $G, $U, $S, ~sk ) ▶₀ #c )
              case Established
              solve( !SatKem( $Sn, ltkK.1 ) ▶₁ #d )
                case Enroll_SAT
                solve( !SatPkSig( $S, pk(x) ) ▶₂ #d )
                  case Enroll_SAT
                  solve( UEKey( $U, sk.1 ) ▶₀ #e )
                    case Established
                    solve( !KU( sign(<'GLINK', $S, $F, aenc(ss, pk(~ltkK)), 
                                      senc(<'GLINK', $S, $F, kdf(<~sk, 'ground-link'>)>, kdf(ss))>,
                                     ~ltkS)
                           ) @ #vk.4 )
                      case Glink_Send
                      solve( !KU( sign(<'USERSESS', $S, $Sn, aenc(ss.1, pk(~ltkK.1)), 
                                        senc(<'USERSESS', $U, $S, $Sn, kdf(<~sk.1, 'next-link', $Sn>)>,
                                             kdf(ss.1))
                                       >,
                                       ~ltkS)
                             ) @ #vk.9 )
                        case Sat_Handover
                        solve( !KU( mac(<'HANDOVER', $U, $S, $Sn>, kdf(<~sk.1, 'order'>))
                               ) @ #vk.10 )
                          case GS_Order_Handover
                          solve( !KU( aenc(~ss, pk(~ltkK)) ) @ #vk.7 )
                            case Glink_Send
                            solve( !KU( senc(<'GLINK', $S, $F, kdf(<~sk, 'ground-link'>)>, kdf(~ss))
                                   ) @ #vk.8 )
                              case Glink_Send
                              solve( !KU( aenc(~ss.1, pk(~ltkK.1)) ) @ #vk.9 )
                                case Sat_Handover
                                solve( !KU( senc(<'USERSESS', $U, $S, $Sn, kdf(<~sk.1, 'next-link', $Sn>)
                                                 >,
                                                 kdf(~ss.1))
                                       ) @ #vk.10 )
                                  case Sat_Handover
                                  SOLVED // trace found
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma sk_secret:
  all-traces
  "∀ U S G sk #i #j.
    ((Established( U, S, G, sk ) @ #i) ∧ (K( sk ) @ #j)) ⇒
    (∃ #r. (CompromisedSat( S, sk ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk #i #j.
  (Established( U, S, G, sk ) @ #i) ∧ (K( sk ) @ #j)
 ∧
  ∀ #r. (CompromisedSat( S, sk ) @ #r) ⇒ ¬(#r < #j)"
*/
simplify
solve( !SatSig( $S, ltkS ) ▶₁ #i )
  case Enroll_SAT
  solve( !KU( ~sk ) @ #vk )
    case Compromise_Serving
    by contradiction /* from formulas */
  qed
qed

lemma glink_secret:
  all-traces
  "∀ U S G sk kgl #i #g #j.
    (((Established( U, S, G, sk ) @ #i) ∧ (GlinkOf( kgl, sk ) @ #g)) ∧
     (K( kgl ) @ #j)) ⇒
    (((∃ #r. CompromisedSat( S, sk ) @ #r) ∨
      (∃ Fd #s #r. (GlinkSent( S, Fd, kgl ) @ #s) ∧ (RevKem( Fd ) @ #r))) ∨
     (∃ Fd #r. CompromisedSat( Fd, kgl ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk kgl #i #g #j.
  (Established( U, S, G, sk ) @ #i) ∧
  (GlinkOf( kgl, sk ) @ #g) ∧
  (K( kgl ) @ #j)
 ∧
  (∀ #r. (CompromisedSat( S, sk ) @ #r) ⇒ ⊥) ∧
  (∀ Fd #s #r. (GlinkSent( S, Fd, kgl ) @ #s) ∧ (RevKem( Fd ) @ #r) ⇒ ⊥) ∧
  (∀ Fd #r. (CompromisedSat( Fd, kgl ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !SatSig( $S, ltkS ) ▶₁ #i )
  case Enroll_SAT
  solve( !Serving( $S, $U, $G, ~sk ) ▶₀ #g )
    case Established
    solve( !SatSig( $S, ltkS ) ▶₂ #g )
      case Enroll_SAT
      solve( !SatPkKem( $F, pkF ) ▶₃ #g )
        case Enroll_SAT
        solve( !KU( kdf(<~sk, 'ground-link'>) ) @ #vk )
          case Compromise_Feeder
          by contradiction /* from formulas */
        next
          case Compromise_Next
          by contradiction /* from formulas */
        next
          case Glink_Send
          solve( !KU( kdf(~ss.1) ) @ #vk.1 )
            case c_kdf
            solve( !KU( ~ss.1 ) @ #vk.2 )
              case Glink_Send
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_kdf
          solve( !KU( ~sk ) @ #vk.2 )
            case Compromise_Serving
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma next_key_secret:
  all-traces
  "∀ U S G sk skn #i #g #j.
    (((Established( U, S, G, sk ) @ #i) ∧ (NextOf( skn, sk ) @ #g)) ∧
     (K( skn ) @ #j)) ⇒
    (((∃ #r. CompromisedSat( S, sk ) @ #r) ∨
      (∃ Sn #s #r.
        (HandoverSent( S, Sn, U, skn ) @ #s) ∧ (RevKem( Sn ) @ #r))) ∨
     (∃ Sn #r. CompromisedSat( Sn, skn ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ U S G sk skn #i #g #j.
  (Established( U, S, G, sk ) @ #i) ∧
  (NextOf( skn, sk ) @ #g) ∧
  (K( skn ) @ #j)
 ∧
  (∀ #r. (CompromisedSat( S, sk ) @ #r) ⇒ ⊥) ∧
  (∀ Sn #s #r.
    (HandoverSent( S, Sn, U, skn ) @ #s) ∧ (RevKem( Sn ) @ #r) ⇒ ⊥) ∧
  (∀ Sn #r. (CompromisedSat( Sn, skn ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !SatSig( $S, ltkS ) ▶₁ #i )
  case Enroll_SAT
  solve( !Serving( $S, $U, $G, ~sk ) ▶₁ #g )
    case Established
    solve( !SatSig( $S, ltkS ) ▶₃ #g )
      case Enroll_SAT
      solve( !SatPkKem( $Sn, pkN ) ▶₄ #g )
        case Enroll_SAT
        solve( !KU( mac(<'HANDOVER', $U, $S, $Sn>, kdf(<~sk, 'order'>)) ) @ #vk )
          case GS_Order_Handover
          solve( !KU( kdf(<~sk, 'next-link', $Sn>) ) @ #vk.1 )
            case Compromise_Feeder
            by contradiction /* from formulas */
          next
            case Compromise_Next
            by contradiction /* from formulas */
          next
            case Sat_Handover
            solve( (#vr.3 < #g)  ∥ (#vr.3 = #g) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              solve( !KU( kdf(~ss) ) @ #vk.2 )
                case c_kdf
                solve( !KU( ~ss ) @ #vk.3 )
                  case Sat_Handover
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case c_kdf
            solve( !KU( ~sk ) @ #vk.3 )
              case Compromise_Serving
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_mac
          solve( !KU( kdf(<~sk, 'next-link', $Sn>) ) @ #vk.1 )
            case Compromise_Feeder
            by contradiction /* from formulas */
          next
            case Compromise_Next
            by contradiction /* from formulas */
          next
            case Sat_Handover
            solve( (#vr.2 < #g)  ∥ (#vr.2 = #g) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              solve( !KU( kdf(<~sk, 'order'>) ) @ #vk.3 )
                case c_kdf
                solve( !KU( ~sk ) @ #vk.12 )
                  case Compromise_Serving
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case c_kdf
            solve( !KU( ~sk ) @ #vk.12 )
              case Compromise_Serving
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

