                      senc(<'USERSESS', $U, $S, $Sn, skn>, kdf(ss))>,
                     ~ltkS)
           ) @ #vk.4 )
      case Sat_Handover
      solve( !KU( mac(<'HANDOVER', $U, $S, $Sn>, kdf(<~sk, 'order'>))
             ) @ #vk.5 )
        case GS_Order_Handover
        by contradiction /* from formulas */
      next
        case c_mac
