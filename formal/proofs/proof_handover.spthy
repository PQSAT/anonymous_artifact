  "∀ Sn S U skn #i.
    (HandoverAccepted( Sn, S, U, skn ) @ #i) ⇒
    (((∃ G sk #j #k.
        ((((HandoverSent( S, Sn, U, skn ) @ #j) ∧ (#j < #i)) ∧
          (HandoverOrdered( G, U, S, Sn, sk ) @ #k)) ∧
         (#k < #j)) ∧
        (NextOf( skn, sk ) @ #j)) ∨
      (∃ #r. (RevSig( S ) @ #r) ∧ (#r < #i))) ∨
     (∃ sk #r. (CompromisedSat( S, sk ) @ #r) ∧ (#r < #i)))"
