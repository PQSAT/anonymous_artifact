    (HandoverOrdered( G, U, S, Sn, sk ) @ #k) ∧
    (NextOf( skn, sk ) @ #j)
   ⇒
    ((¬(#j < #i)) ∨ (¬(#k < #j)))) ∧
  (∀ #r. (RevSig( S ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ sk #r. (CompromisedSat( S, sk ) @ #r) ⇒ ¬(#r < #i))"
*/
simplify
solve( !SatKem( $Sn, ltkK ) ▶₁ #i )
  case Enroll_SAT
