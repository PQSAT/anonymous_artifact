/* ------------------------------------------------------------------ */
/* Limit that remains, shown by a trace                                */
/* ------------------------------------------------------------------ */

// R0  the two conditions are tight: with BOTH long term keys of the
//     satellite (ML-DSA and ML-KEM) the adversary takes the place of the
//     satellite and learns SK. No satellite takes part in this trace.
lemma R0_both_keys_of_one_party [heuristic={kemmode}, hide_lemma=gs_secret_kgs, hide_lemma=gs_secret_kgu]:
  exists-trace
  "Ex U S G muU sk #a #i #j. UE_Start(U, S, G, muU) @a & SKey('GS', U, S, G, sk) @i & K(sk) @j
    & not (Ex S2 X G2 muX epk #r. SAT_AcceptMsg1(S2, X, G2, muX, epk) @r)
    & (All U2 S2 G2 m #x. UE_Start(U2, S2, G2, m) @x ==> #x = #a)
    & (All G2 U2 S2 m1 m2 #x. GS_AcceptMsg2(G2, U2, S2, m1, m2) @x ==> U2 = U & S2 = S & G2 = G)
    & not (U = S) & not (S = G) & not (U = G)
    & (All X #r. RevSig(X) @r ==> X = S)
    & (All X #r. RevKem(X) @r ==> X = S)
    & not (Ex e #r. RevEph(e) @r) & not (Ex e #r. RevKsu(e) @r)
    & not (Ex e #r. RevKgs(e) @r) & not (Ex e #r. RevKgu(e) @r)"

end
